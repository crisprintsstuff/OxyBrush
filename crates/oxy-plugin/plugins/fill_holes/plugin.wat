;; Fill Holes: an in-app OxyBrush plugin in WebAssembly text (API 3).
;; Finds open boundary loops (an edge used by one triangle) and caps each
;; one that is small enough. The loop is walked opposite the neighbouring
;; triangles, so the new faces point the same way, then filled by ear
;; clipping in the loop's best-fit plane. No existing vertex moves and no
;; existing triangle changes: write_mesh is only how a plugin can add
;; triangles, so the mask, color, groups and hidden flags are written back
;; afterwards (new triangles are visible, and each patch can take the next
;; face group).
;;
;; Not a live preview: a large opening is O(n^2) to clip, and preview runs
;; on every setting change. Progress is reported and Stop returns before
;; anything is written.
;;
;; Scratch: loop vertices at 1024, prev/next links, and 2D coordinates, all
;; sized for the 512-edge maximum. The mesh copy starts at 16384.
(module
  (import "oxybrush" "log" (func $log (param i32 i32)))
  (import "oxybrush" "param" (func $param (param i32) (result f32)))
  (import "oxybrush" "active_piece" (func $active (result i32)))
  (import "oxybrush" "vertex_count" (func $vertex_count (param i32) (result i32)))
  (import "oxybrush" "triangle_count" (func $triangle_count (param i32) (result i32)))
  (import "oxybrush" "read_positions" (func $read_positions (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_triangles" (func $read_triangles (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_mask" (func $read_mask (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_colors" (func $read_colors (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_groups" (func $read_groups (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_hidden" (func $read_hidden (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_mesh" (func $write_mesh (param i32 i32 i32 i32 i32) (result i32)))
  (import "oxybrush" "write_mask" (func $write_mask (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_colors" (func $write_colors (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_groups" (func $write_groups (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_hidden" (func $write_hidden (param i32 i32 i32) (result i32)))
  (import "oxybrush" "progress" (func $progress (param f32) (result i32)))

  (memory (export "memory") 1)
  (data (i32.const 0) "No holes to fill")
  (data (i32.const 32) "Filled ")
  (data (i32.const 48) " hole")
  (data (i32.const 64) " holes")
  (data (i32.const 96) "Holes are larger than the limit")
  (data (i32.const 160) "The piece is too large for a plugin")
  (data (i32.const 224) "Couldn't read the mesh")
  (data (i32.const 288) "Couldn't change the mesh")

  (global $gpos (mut i32) (i32.const 0))
  (global $gtri (mut i32) (i32.const 0))
  (global $gmask (mut i32) (i32.const 0))
  (global $gcol (mut i32) (i32.const 0))
  (global $ggrp (mut i32) (i32.const 0))
  (global $ghid (mut i32) (i32.const 0))
  (global $ghash (mut i32) (i32.const 0))
  (global $ghashm (mut i32) (i32.const 0))
  (global $gedges (mut i32) (i32.const 0))
  (global $gused (mut i32) (i32.const 0))
  (global $gfirst (mut i32) (i32.const 0))
  (global $gout (mut i32) (i32.const 0))
  (global $gogrp (mut i32) (i32.const 0))
  (global $gohid (mut i32) (i32.const 0))
  (global $gn (mut i32) (i32.const 0))
  (global $gnt (mut i32) (i32.const 0))
  (global $gB (mut i32) (i32.const 0))
  (global $goutn (mut i32) (i32.const 0))
  (global $gcap (mut i32) (i32.const 0))
  (global $gpiece (mut i32) (i32.const 0))
  (global $gstop (mut i32) (i32.const 0))
  (global $gfilled (mut i32) (i32.const 0))
  (global $gskipped (mut i32) (i32.const 0))
  (global $guse (mut i32) (i32.const 1))
  (global $gnextg (mut i32) (i32.const 1))
  (global $gcurg (mut i32) (i32.const 0))
  (global $gnx (mut f32) (f32.const 0))
  (global $gny (mut f32) (f32.const 0))
  (global $gnz (mut f32) (f32.const 0))
  (global $gtx (mut f32) (f32.const 1))
  (global $gty (mut f32) (f32.const 0))
  (global $gtz (mut f32) (f32.const 0))
  (global $gbx (mut f32) (f32.const 0))
  (global $gby (mut f32) (f32.const 1))
  (global $gbz (mut f32) (f32.const 0))
  (global $geps (mut f32) (f32.const 1e-12))
  (global $geps2 (mut f32) (f32.const 1e-8))

  (func $ensure (param $end i32) (result i32)
    (local $need i32)
    (if (i32.lt_s (local.get $end) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $need (i32.div_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 65536)))
    (if (i32.gt_u (local.get $need) (memory.size))
      (then
        (if (i32.eq (memory.grow (i32.sub (local.get $need) (memory.size))) (i32.const -1))
          (then (return (i32.const 0))))))
    (i32.const 1))

  (func $put_str (param $src i32) (param $len i32) (param $at i32) (result i32)
    (memory.copy (local.get $at) (local.get $src) (local.get $len))
    (i32.add (local.get $at) (local.get $len)))

  (func $put_u (param $n i32) (param $at i32) (result i32)
    (local $len i32) (local $m i32) (local $i i32)
    (local.set $m (local.get $n))
    (local.set $len (i32.const 1))
    (block $done (loop $count
      (br_if $done (i32.lt_u (local.get $m) (i32.const 10)))
      (local.set $m (i32.div_u (local.get $m) (i32.const 10)))
      (local.set $len (i32.add (local.get $len) (i32.const 1)))
      (br $count)))
    (local.set $i (local.get $len))
    (local.set $m (local.get $n))
    (block $done2 (loop $write
      (br_if $done2 (i32.eqz (local.get $i)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (i32.store8 (i32.add (local.get $at) (local.get $i))
        (i32.add (i32.const 48) (i32.rem_u (local.get $m) (i32.const 10))))
      (local.set $m (i32.div_u (local.get $m) (i32.const 10)))
      (br $write)))
    (i32.add (local.get $at) (local.get $len)))

  (func $pow2 (param $n i32) (result i32)
    (local $p i32)
    (if (i32.lt_u (local.get $n) (i32.const 2)) (then (return (i32.const 2))))
    (local.set $p (i32.const 1))
    (block $done (loop $shift
      (br_if $done (i32.ge_u (local.get $p) (local.get $n)))
      (local.set $p (i32.shl (local.get $p) (i32.const 1)))
      (br_if $done (i32.le_s (local.get $p) (i32.const 0)))
      (br $shift)))
    (local.get $p))

  (func $px (param $v i32) (result f32)
    (f32.load (i32.add (global.get $gpos) (i32.mul (local.get $v) (i32.const 12)))))
  (func $py (param $v i32) (result f32)
    (f32.load offset=4 (i32.add (global.get $gpos) (i32.mul (local.get $v) (i32.const 12)))))
  (func $pz (param $v i32) (result f32)
    (f32.load offset=8 (i32.add (global.get $gpos) (i32.mul (local.get $v) (i32.const 12)))))
  (func $corner (param $t i32) (param $k i32) (result i32)
    (i32.load (i32.add (global.get $gtri)
      (i32.add (i32.mul (local.get $t) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4))))))
  (func $loopv (param $i i32) (result i32)
    (i32.load (i32.add (i32.const 1024) (i32.mul (local.get $i) (i32.const 4)))))
  (func $prev (param $i i32) (result i32)
    (i32.load (i32.add (i32.const 3072) (i32.mul (local.get $i) (i32.const 4)))))
  (func $next (param $i i32) (result i32)
    (i32.load (i32.add (i32.const 5120) (i32.mul (local.get $i) (i32.const 4)))))
  (func $set_prev (param $i i32) (param $v i32)
    (i32.store (i32.add (i32.const 3072) (i32.mul (local.get $i) (i32.const 4))) (local.get $v)))
  (func $set_next (param $i i32) (param $v i32)
    (i32.store (i32.add (i32.const 5120) (i32.mul (local.get $i) (i32.const 4))) (local.get $v)))

  (func $stopped (param $frac f32) (result i32)
    (if (call $progress (local.get $frac))
      (then (global.set $gstop (i32.const 1)) (return (i32.const 1))))
    (i32.const 0))

  ;; ---- edge counts (open addressing; empty key is -1) ----
  (func $count_edge (param $a i32) (param $b i32)
    (local $tmp i32) (local $h i32) (local $slot i32) (local $probes i32)
    (if (i32.eq (local.get $a) (local.get $b)) (then (return)))
    (if (i32.gt_u (local.get $a) (local.get $b))
      (then
        (local.set $tmp (local.get $a))
        (local.set $a (local.get $b))
        (local.set $b (local.get $tmp))))
    (local.set $h (i32.and
      (i32.xor (i32.mul (local.get $a) (i32.const 0x45d9f3b)) (i32.mul (local.get $b) (i32.const 0x27d4eb2d)))
      (global.get $ghashm)))
    (local.set $probes (i32.const 0))
    (block $done (loop $probe
      (local.set $slot (i32.add (global.get $ghash) (i32.mul (local.get $h) (i32.const 12))))
      (local.set $tmp (i32.load (local.get $slot)))
      (if (i32.eq (local.get $tmp) (i32.const -1))
        (then
          (i32.store (local.get $slot) (local.get $a))
          (i32.store offset=4 (local.get $slot) (local.get $b))
          (i32.store offset=8 (local.get $slot) (i32.const 1))
          (return)))
      (if (i32.and (i32.eq (local.get $tmp) (local.get $a))
                   (i32.eq (i32.load offset=4 (local.get $slot)) (local.get $b)))
        (then
          (i32.store offset=8 (local.get $slot) (i32.add (i32.load offset=8 (local.get $slot)) (i32.const 1)))
          (return)))
      (local.set $h (i32.and (i32.add (local.get $h) (i32.const 1)) (global.get $ghashm)))
      (local.set $probes (i32.add (local.get $probes) (i32.const 1)))
      (br_if $done (i32.gt_u (local.get $probes) (global.get $ghashm)))
      (br $probe))))

  (func $edge_count (param $a i32) (param $b i32) (result i32)
    (local $tmp i32) (local $h i32) (local $slot i32) (local $probes i32)
    (if (i32.gt_u (local.get $a) (local.get $b))
      (then
        (local.set $tmp (local.get $a))
        (local.set $a (local.get $b))
        (local.set $b (local.get $tmp))))
    (local.set $h (i32.and
      (i32.xor (i32.mul (local.get $a) (i32.const 0x45d9f3b)) (i32.mul (local.get $b) (i32.const 0x27d4eb2d)))
      (global.get $ghashm)))
    (local.set $probes (i32.const 0))
    (block $done (loop $probe
      (local.set $slot (i32.add (global.get $ghash) (i32.mul (local.get $h) (i32.const 12))))
      (local.set $tmp (i32.load (local.get $slot)))
      (if (i32.eq (local.get $tmp) (i32.const -1)) (then (return (i32.const 0))))
      (if (i32.and (i32.eq (local.get $tmp) (local.get $a))
                   (i32.eq (i32.load offset=4 (local.get $slot)) (local.get $b)))
        (then (return (i32.load offset=8 (local.get $slot)))))
      (local.set $h (i32.and (i32.add (local.get $h) (i32.const 1)) (global.get $ghashm)))
      (local.set $probes (i32.add (local.get $probes) (i32.const 1)))
      (br_if $done (i32.gt_u (local.get $probes) (global.get $ghashm)))
      (br $probe)))
    (i32.const 0))

  (func $efrom (param $i i32) (result i32)
    (i32.load (i32.add (global.get $gedges) (i32.mul (local.get $i) (i32.const 8)))))
  (func $eto (param $i i32) (result i32)
    (i32.load offset=4 (i32.add (global.get $gedges) (i32.mul (local.get $i) (i32.const 8)))))

  (func $edge_less (param $i i32) (param $j i32) (result i32)
    (local $a i32) (local $b i32)
    (local.set $a (call $efrom (local.get $i)))
    (local.set $b (call $efrom (local.get $j)))
    (if (i32.lt_u (local.get $a) (local.get $b)) (then (return (i32.const 1))))
    (if (i32.gt_u (local.get $a) (local.get $b)) (then (return (i32.const 0))))
    (i32.lt_u (call $eto (local.get $i)) (call $eto (local.get $j))))

  (func $swap_edge (param $i i32) (param $j i32)
    (local $pi i32) (local $pj i32) (local $a i32) (local $b i32)
    (local.set $pi (i32.add (global.get $gedges) (i32.mul (local.get $i) (i32.const 8))))
    (local.set $pj (i32.add (global.get $gedges) (i32.mul (local.get $j) (i32.const 8))))
    (local.set $a (i32.load (local.get $pi)))
    (i32.store (local.get $pi) (i32.load (local.get $pj)))
    (i32.store (local.get $pj) (local.get $a))
    (local.set $b (i32.load offset=4 (local.get $pi)))
    (i32.store offset=4 (local.get $pi) (i32.load offset=4 (local.get $pj)))
    (i32.store offset=4 (local.get $pj) (local.get $b)))

  (func $sift (param $root i32) (param $count i32)
    (local $child i32) (local $swap i32)
    (block $done (loop $down
      (local.set $child (i32.add (i32.shl (local.get $root) (i32.const 1)) (i32.const 1)))
      (br_if $done (i32.ge_u (local.get $child) (local.get $count)))
      (local.set $swap (local.get $root))
      (if (call $edge_less (local.get $swap) (local.get $child))
        (then (local.set $swap (local.get $child))))
      (if (i32.lt_u (i32.add (local.get $child) (i32.const 1)) (local.get $count))
        (then
          (if (call $edge_less (local.get $swap) (i32.add (local.get $child) (i32.const 1)))
            (then (local.set $swap (i32.add (local.get $child) (i32.const 1)))))))
      (br_if $done (i32.eq (local.get $swap) (local.get $root)))
      (call $swap_edge (local.get $root) (local.get $swap))
      (local.set $root (local.get $swap))
      (br $down))))

  (func $heapsort (param $n i32)
    (local $i i32)
    (if (i32.lt_u (local.get $n) (i32.const 2)) (then (return)))
    (local.set $i (i32.shr_u (local.get $n) (i32.const 1)))
    (block $h (loop $heap
      (br_if $h (i32.eqz (local.get $i)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (call $sift (local.get $i) (local.get $n))
      (br $heap)))
    (local.set $i (local.get $n))
    (block $e (loop $extract
      (br_if $e (i32.le_u (local.get $i) (i32.const 1)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (call $swap_edge (i32.const 0) (local.get $i))
      (call $sift (i32.const 0) (local.get $i))
      (br $extract))))

  ;; ---- filling one loop, vertices already at 1024 ----
  (func $emit (param $i0 i32) (param $i1 i32) (param $i2 i32) (result i32)
    (local $a i32) (local $b i32) (local $c i32) (local $at i32)
    (local $ux f32) (local $uy f32) (local $uz f32)
    (local $vx f32) (local $vy f32) (local $vz f32)
    (local $cx f32) (local $cy f32) (local $cz f32) (local $len2 f32)
    (if (i32.ge_u (global.get $goutn) (global.get $gcap)) (then (return (i32.const 0))))
    (local.set $a (call $loopv (local.get $i0)))
    (local.set $b (call $loopv (local.get $i1)))
    (local.set $c (call $loopv (local.get $i2)))
    (if (i32.or (i32.ge_u (local.get $a) (global.get $gn))
          (i32.or (i32.ge_u (local.get $b) (global.get $gn)) (i32.ge_u (local.get $c) (global.get $gn))))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eq (local.get $a) (local.get $b))
          (i32.or (i32.eq (local.get $b) (local.get $c)) (i32.eq (local.get $a) (local.get $c))))
      (then (return (i32.const 0))))
    (local.set $ux (f32.sub (call $px (local.get $b)) (call $px (local.get $a))))
    (local.set $uy (f32.sub (call $py (local.get $b)) (call $py (local.get $a))))
    (local.set $uz (f32.sub (call $pz (local.get $b)) (call $pz (local.get $a))))
    (local.set $vx (f32.sub (call $px (local.get $c)) (call $px (local.get $a))))
    (local.set $vy (f32.sub (call $py (local.get $c)) (call $py (local.get $a))))
    (local.set $vz (f32.sub (call $pz (local.get $c)) (call $pz (local.get $a))))
    (local.set $cx (f32.sub (f32.mul (local.get $uy) (local.get $vz)) (f32.mul (local.get $uz) (local.get $vy))))
    (local.set $cy (f32.sub (f32.mul (local.get $uz) (local.get $vx)) (f32.mul (local.get $ux) (local.get $vz))))
    (local.set $cz (f32.sub (f32.mul (local.get $ux) (local.get $vy)) (f32.mul (local.get $uy) (local.get $vx))))
    (local.set $len2 (f32.add (f32.mul (local.get $cx) (local.get $cx))
      (f32.add (f32.mul (local.get $cy) (local.get $cy)) (f32.mul (local.get $cz) (local.get $cz)))))
    (if (f32.lt (local.get $len2) (global.get $geps)) (then (return (i32.const 0))))
    (local.set $at (i32.add (global.get $gout) (i32.mul (global.get $goutn) (i32.const 12))))
    (i32.store (local.get $at) (local.get $a))
    (i32.store offset=4 (local.get $at) (local.get $b))
    (i32.store offset=8 (local.get $at) (local.get $c))
    (i32.store (i32.add (global.get $gogrp) (i32.mul (global.get $goutn) (i32.const 4))) (global.get $gcurg))
    (i32.store8 (i32.add (global.get $gohid) (global.get $goutn)) (i32.const 0))
    (global.set $goutn (i32.add (global.get $goutn) (i32.const 1)))
    (i32.const 1))

  (func $uv (param $i i32) (param $which i32) (result f32)
    (f32.load (i32.add (i32.const 7168)
      (i32.add (i32.mul (local.get $i) (i32.const 8)) (i32.mul (local.get $which) (i32.const 4))))))

  (func $cross2 (param $ax f32) (param $ay f32) (param $bx f32) (param $by f32) (result f32)
    (f32.sub (f32.mul (local.get $ax) (local.get $by)) (f32.mul (local.get $ay) (local.get $bx))))

  (func $in_tri (param $j i32) (param $i0 i32) (param $i1 i32) (param $i2 i32) (result i32)
    (local $ax f32) (local $ay f32) (local $bx f32) (local $by f32) (local $cx f32) (local $cy f32)
    (local $px f32) (local $py f32) (local $c1 f32) (local $c2 f32) (local $c3 f32)
    (local $neg i32) (local $pos i32)
    (local.set $ax (call $uv (local.get $i0) (i32.const 0)))
    (local.set $ay (call $uv (local.get $i0) (i32.const 1)))
    (local.set $bx (call $uv (local.get $i1) (i32.const 0)))
    (local.set $by (call $uv (local.get $i1) (i32.const 1)))
    (local.set $cx (call $uv (local.get $i2) (i32.const 0)))
    (local.set $cy (call $uv (local.get $i2) (i32.const 1)))
    (local.set $px (call $uv (local.get $j) (i32.const 0)))
    (local.set $py (call $uv (local.get $j) (i32.const 1)))
    (local.set $c1 (call $cross2
      (f32.sub (local.get $bx) (local.get $ax)) (f32.sub (local.get $by) (local.get $ay))
      (f32.sub (local.get $px) (local.get $ax)) (f32.sub (local.get $py) (local.get $ay))))
    (local.set $c2 (call $cross2
      (f32.sub (local.get $cx) (local.get $bx)) (f32.sub (local.get $cy) (local.get $by))
      (f32.sub (local.get $px) (local.get $bx)) (f32.sub (local.get $py) (local.get $by))))
    (local.set $c3 (call $cross2
      (f32.sub (local.get $ax) (local.get $cx)) (f32.sub (local.get $ay) (local.get $cy))
      (f32.sub (local.get $px) (local.get $cx)) (f32.sub (local.get $py) (local.get $cy))))
    (local.set $neg (i32.or (i32.or
      (f32.lt (local.get $c1) (f32.neg (global.get $geps2)))
      (f32.lt (local.get $c2) (f32.neg (global.get $geps2))))
      (f32.lt (local.get $c3) (f32.neg (global.get $geps2)))))
    (local.set $pos (i32.or (i32.or
      (f32.gt (local.get $c1) (global.get $geps2))
      (f32.gt (local.get $c2) (global.get $geps2)))
      (f32.gt (local.get $c3) (global.get $geps2))))
    (i32.eqz (i32.and (local.get $neg) (local.get $pos))))

  (func $convex (param $i i32) (result i32)
    (local $p i32) (local $n i32) (local $a i32) (local $b i32) (local $c i32)
    (local $ux f32) (local $uy f32) (local $uz f32)
    (local $vx f32) (local $vy f32) (local $vz f32)
    (local $cx f32) (local $cy f32) (local $cz f32) (local $dot f32)
    (local.set $p (call $prev (local.get $i)))
    (local.set $n (call $next (local.get $i)))
    (local.set $a (call $loopv (local.get $p)))
    (local.set $b (call $loopv (local.get $i)))
    (local.set $c (call $loopv (local.get $n)))
    (local.set $ux (f32.sub (call $px (local.get $b)) (call $px (local.get $a))))
    (local.set $uy (f32.sub (call $py (local.get $b)) (call $py (local.get $a))))
    (local.set $uz (f32.sub (call $pz (local.get $b)) (call $pz (local.get $a))))
    (local.set $vx (f32.sub (call $px (local.get $c)) (call $px (local.get $b))))
    (local.set $vy (f32.sub (call $py (local.get $c)) (call $py (local.get $b))))
    (local.set $vz (f32.sub (call $pz (local.get $c)) (call $pz (local.get $b))))
    (local.set $cx (f32.sub (f32.mul (local.get $uy) (local.get $vz)) (f32.mul (local.get $uz) (local.get $vy))))
    (local.set $cy (f32.sub (f32.mul (local.get $uz) (local.get $vx)) (f32.mul (local.get $ux) (local.get $vz))))
    (local.set $cz (f32.sub (f32.mul (local.get $ux) (local.get $vy)) (f32.mul (local.get $uy) (local.get $vx))))
    (local.set $dot (f32.add (f32.mul (local.get $cx) (global.get $gnx))
      (f32.add (f32.mul (local.get $cy) (global.get $gny)) (f32.mul (local.get $cz) (global.get $gnz)))))
    (f32.gt (local.get $dot) (global.get $geps)))

  (func $any_inside (param $i i32) (result i32)
    (local $j i32) (local $stop i32) (local $guard i32)
    (local.set $stop (call $prev (local.get $i)))
    (local.set $j (call $next (call $next (local.get $i))))
    (local.set $guard (i32.const 0))
    (block $done (loop $walk
      (br_if $done (i32.eq (local.get $j) (local.get $stop)))
      (br_if $done (i32.gt_u (local.get $guard) (i32.const 512)))
      (if (call $in_tri (local.get $j) (call $prev (local.get $i)) (local.get $i) (call $next (local.get $i)))
        (then (return (i32.const 1))))
      (local.set $j (call $next (local.get $j)))
      (local.set $guard (i32.add (local.get $guard) (i32.const 1)))
      (br $walk)))
    (i32.const 0))

  (func $fan (param $start i32)
    (local $j i32) (local $guard i32)
    (local.set $j (call $next (local.get $start)))
    (local.set $guard (i32.const 0))
    (block $done (loop $step
      (br_if $done (i32.gt_u (local.get $guard) (i32.const 512)))
      (local.set $guard (i32.add (local.get $guard) (i32.const 1)))
      (br_if $done (i32.eq (call $next (local.get $j)) (local.get $start)))
      (drop (call $emit (local.get $start) (local.get $j) (call $next (local.get $j))))
      (local.set $j (call $next (local.get $j)))
      (br $step))))

  (func $norm3 (param $x f32) (param $y f32) (param $z f32) (result f32)
    (f32.sqrt (f32.add (f32.mul (local.get $x) (local.get $x))
      (f32.add (f32.mul (local.get $y) (local.get $y)) (f32.mul (local.get $z) (local.get $z))))))

  ;; Build the plane and the 2D coordinates. Returns 0 if the loop is flat
  ;; to nothing (no normal), so the caller leaves that opening alone.
  (func $prepare (param $len i32) (result i32)
    (local $i i32) (local $a i32) (local $b i32)
    (local $px f32) (local $py f32) (local $pz f32) (local $qx f32) (local $qy f32) (local $qz f32)
    (local $nx f32) (local $ny f32) (local $nz f32) (local $lenn f32)
    (local $rx f32) (local $ry f32) (local $rz f32)
    (local $tx f32) (local $ty f32) (local $tz f32)
    (local $bx f32) (local $by f32) (local $bz f32)
    (local $ox f32) (local $oy f32) (local $oz f32)
    (local $dx f32) (local $dy f32) (local $dz f32)
    (local $minx f32) (local $miny f32) (local $minz f32)
    (local $maxx f32) (local $maxy f32) (local $maxz f32)
    (local $scale f32) (local $u f32) (local $v f32)
    (local.set $nx (f32.const 0))
    (local.set $ny (f32.const 0))
    (local.set $nz (f32.const 0))
    (local.set $minx (f32.const inf))
    (local.set $miny (f32.const inf))
    (local.set $minz (f32.const inf))
    (local.set $maxx (f32.const -inf))
    (local.set $maxy (f32.const -inf))
    (local.set $maxz (f32.const -inf))
    (local.set $i (i32.const 0))
    (block $dn (loop $n
      (br_if $dn (i32.ge_u (local.get $i) (local.get $len)))
      (local.set $a (call $loopv (local.get $i)))
      (local.set $b (call $loopv (i32.rem_u (i32.add (local.get $i) (i32.const 1)) (local.get $len))))
      (local.set $px (call $px (local.get $a)))
      (local.set $py (call $py (local.get $a)))
      (local.set $pz (call $pz (local.get $a)))
      (local.set $qx (call $px (local.get $b)))
      (local.set $qy (call $py (local.get $b)))
      (local.set $qz (call $pz (local.get $b)))
      (local.set $nx (f32.add (local.get $nx)
        (f32.mul (f32.sub (local.get $py) (local.get $qy)) (f32.add (local.get $pz) (local.get $qz)))))
      (local.set $ny (f32.add (local.get $ny)
        (f32.mul (f32.sub (local.get $pz) (local.get $qz)) (f32.add (local.get $px) (local.get $qx)))))
      (local.set $nz (f32.add (local.get $nz)
        (f32.mul (f32.sub (local.get $px) (local.get $qx)) (f32.add (local.get $py) (local.get $qy)))))
      (local.set $minx (f32.min (local.get $minx) (local.get $px)))
      (local.set $miny (f32.min (local.get $miny) (local.get $py)))
      (local.set $minz (f32.min (local.get $minz) (local.get $pz)))
      (local.set $maxx (f32.max (local.get $maxx) (local.get $px)))
      (local.set $maxy (f32.max (local.get $maxy) (local.get $py)))
      (local.set $maxz (f32.max (local.get $maxz) (local.get $pz)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $n)))
    (local.set $lenn (call $norm3 (local.get $nx) (local.get $ny) (local.get $nz)))
    (if (f32.lt (local.get $lenn) (f32.const 1e-12)) (then (return (i32.const 0))))
    (global.set $gnx (f32.div (local.get $nx) (local.get $lenn)))
    (global.set $gny (f32.div (local.get $ny) (local.get $lenn)))
    (global.set $gnz (f32.div (local.get $nz) (local.get $lenn)))
    (local.set $scale (f32.add
      (f32.mul (f32.sub (local.get $maxx) (local.get $minx)) (f32.sub (local.get $maxx) (local.get $minx)))
      (f32.add
        (f32.mul (f32.sub (local.get $maxy) (local.get $miny)) (f32.sub (local.get $maxy) (local.get $miny)))
        (f32.mul (f32.sub (local.get $maxz) (local.get $minz)) (f32.sub (local.get $maxz) (local.get $minz))))))
    (global.set $geps (f32.max (f32.mul (local.get $scale) (f32.const 1e-14)) (f32.const 1e-20)))
    ;; A tangent perpendicular to the normal, then the second axis.
    (local.set $rx (f32.const 0))
    (local.set $ry (f32.const 0))
    (local.set $rz (f32.const 0))
    (if (i32.and (f32.le (f32.abs (global.get $gnx)) (f32.abs (global.get $gny)))
                 (f32.le (f32.abs (global.get $gnx)) (f32.abs (global.get $gnz))))
      (then (local.set $rx (f32.const 1)))
      (else
        (if (f32.le (f32.abs (global.get $gny)) (f32.abs (global.get $gnz)))
          (then (local.set $ry (f32.const 1)))
          (else (local.set $rz (f32.const 1))))))
    (local.set $tx (f32.sub (f32.mul (local.get $ry) (global.get $gnz)) (f32.mul (local.get $rz) (global.get $gny))))
    (local.set $ty (f32.sub (f32.mul (local.get $rz) (global.get $gnx)) (f32.mul (local.get $rx) (global.get $gnz))))
    (local.set $tz (f32.sub (f32.mul (local.get $rx) (global.get $gny)) (f32.mul (local.get $ry) (global.get $gnx))))
    (local.set $lenn (call $norm3 (local.get $tx) (local.get $ty) (local.get $tz)))
    (if (f32.lt (local.get $lenn) (f32.const 1e-12)) (then (return (i32.const 0))))
    (global.set $gtx (f32.div (local.get $tx) (local.get $lenn)))
    (global.set $gty (f32.div (local.get $ty) (local.get $lenn)))
    (global.set $gtz (f32.div (local.get $tz) (local.get $lenn)))
    (global.set $gbx (f32.sub (f32.mul (global.get $gny) (global.get $gtz)) (f32.mul (global.get $gnz) (global.get $gty))))
    (global.set $gby (f32.sub (f32.mul (global.get $gnz) (global.get $gtx)) (f32.mul (global.get $gnx) (global.get $gtz))))
    (global.set $gbz (f32.sub (f32.mul (global.get $gnx) (global.get $gty)) (f32.mul (global.get $gny) (global.get $gtx))))
    (local.set $a (call $loopv (i32.const 0)))
    (local.set $ox (call $px (local.get $a)))
    (local.set $oy (call $py (local.get $a)))
    (local.set $oz (call $pz (local.get $a)))
    (local.set $scale (f32.const 0))
    (local.set $i (i32.const 0))
    (block $du (loop $proj
      (br_if $du (i32.ge_u (local.get $i) (local.get $len)))
      (local.set $b (call $loopv (local.get $i)))
      (local.set $dx (f32.sub (call $px (local.get $b)) (local.get $ox)))
      (local.set $dy (f32.sub (call $py (local.get $b)) (local.get $oy)))
      (local.set $dz (f32.sub (call $pz (local.get $b)) (local.get $oz)))
      (local.set $u (f32.add (f32.mul (local.get $dx) (global.get $gtx))
        (f32.add (f32.mul (local.get $dy) (global.get $gty)) (f32.mul (local.get $dz) (global.get $gtz)))))
      (local.set $v (f32.add (f32.mul (local.get $dx) (global.get $gbx))
        (f32.add (f32.mul (local.get $dy) (global.get $gby)) (f32.mul (local.get $dz) (global.get $gbz)))))
      (f32.store (i32.add (i32.const 7168) (i32.mul (local.get $i) (i32.const 8))) (local.get $u))
      (f32.store offset=4 (i32.add (i32.const 7168) (i32.mul (local.get $i) (i32.const 8))) (local.get $v))
      (local.set $scale (f32.max (local.get $scale) (f32.max (f32.abs (local.get $u)) (f32.abs (local.get $v)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $proj)))
    (global.set $geps2 (f32.max (f32.mul (local.get $scale) (f32.const 1e-6)) (f32.const 1e-8)))
    (i32.const 1))

  (func $fill_loop (param $len i32)
    (local $i i32) (local $rem i32) (local $start i32) (local $tries i32)
    (local $guard i32) (local $found i32) (local $before i32)
    (if (i32.lt_u (local.get $len) (i32.const 3)) (then (return)))
    (if (i32.eqz (call $prepare (local.get $len))) (then (return)))
    (local.set $before (global.get $goutn))
    (local.set $i (i32.const 0))
    (block $dl (loop $links
      (br_if $dl (i32.ge_u (local.get $i) (local.get $len)))
      ;; `select` is easy to get backwards here, and a wrong link drops a
      ;; corner of the hole. Spell the wraparound out.
      (if (i32.eqz (local.get $i))
        (then (call $set_prev (local.get $i) (i32.sub (local.get $len) (i32.const 1))))
        (else (call $set_prev (local.get $i) (i32.sub (local.get $i) (i32.const 1)))))
      (if (i32.eq (local.get $i) (i32.sub (local.get $len) (i32.const 1)))
        (then (call $set_next (local.get $i) (i32.const 0)))
        (else (call $set_next (local.get $i) (i32.add (local.get $i) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $links)))
    (local.set $rem (local.get $len))
    (local.set $start (i32.const 0))
    (local.set $guard (i32.const 0))
    (block $out (loop $round
      (br_if $out (i32.le_u (local.get $rem) (i32.const 3)))
      (br_if $out (i32.gt_u (local.get $guard) (i32.mul (local.get $len) (local.get $len))))
      (if (i32.eqz (i32.and (local.get $guard) (i32.const 31)))
        (then (if (call $stopped (f32.const 0.8)) (then (return)))))
      (local.set $guard (i32.add (local.get $guard) (i32.const 1)))
      (local.set $i (local.get $start))
      (local.set $tries (i32.const 0))
      (local.set $found (i32.const 0))
      (block $scan (loop $try
        (br_if $scan (i32.ge_u (local.get $tries) (local.get $rem)))
        (if (i32.and (call $convex (local.get $i)) (i32.eqz (call $any_inside (local.get $i))))
          (then
            (drop (call $emit (call $prev (local.get $i)) (local.get $i) (call $next (local.get $i))))
            (call $set_next (call $prev (local.get $i)) (call $next (local.get $i)))
            (call $set_prev (call $next (local.get $i)) (call $prev (local.get $i)))
            (local.set $start (call $next (local.get $i)))
            (local.set $rem (i32.sub (local.get $rem) (i32.const 1)))
            (local.set $found (i32.const 1))
            (br $scan)))
        (local.set $i (call $next (local.get $i)))
        (local.set $tries (i32.add (local.get $tries) (i32.const 1)))
        (br $try)))
      (if (i32.eqz (local.get $found))
        (then (call $fan (local.get $start)) (br $out)))
      (br $round)))
    (if (i32.eq (local.get $rem) (i32.const 3))
      (then
        (drop (call $emit (local.get $start) (call $next (local.get $start))
          (call $next (call $next (local.get $start)))))))
    (if (i32.gt_u (global.get $goutn) (local.get $before))
      (then
        (global.set $gfilled (i32.add (global.get $gfilled) (i32.const 1)))
        (if (global.get $guse)
          (then (global.set $gnextg (i32.add (global.get $gnextg) (i32.const 1))))))))

  (func $log_done
    (local $at i32)
    (if (i32.eqz (global.get $gfilled))
      (then
        (if (i32.gt_u (global.get $gskipped) (i32.const 0))
          (then (call $log (i32.const 96) (i32.const 31)))
          (else (call $log (i32.const 0) (i32.const 16))))
        (return)))
    (local.set $at (call $put_str (i32.const 32) (i32.const 7) (i32.const 512)))
    (local.set $at (call $put_u (global.get $gfilled) (local.get $at)))
    (if (i32.eq (global.get $gfilled) (i32.const 1))
      (then (local.set $at (call $put_str (i32.const 48) (i32.const 5) (local.get $at))))
      (else (local.set $at (call $put_str (i32.const 64) (i32.const 6) (local.get $at)))))
    (call $log (i32.const 512) (i32.sub (local.get $at) (i32.const 512))))

  (func (export "run") (param $command i32)
    (local $n i32) (local $nt i32) (local $piece i32) (local $rc i32)
    (local $slots i32) (local $edge_cap i32) (local $end i32)
    (local $i i32) (local $k i32) (local $a i32) (local $b i32)
    (local $maxh i32) (local $len i32) (local $v i32) (local $j i32)
    (local $found i32) (local $to i32) (local $guard i32) (local $closed i32)
    (local $g i32) (local $maxg i32)
    (if (call $stopped (f32.const 0)) (then (return)))
    (local.set $piece (call $active))
    (global.set $gpiece (local.get $piece))
    (local.set $n (call $vertex_count (local.get $piece)))
    (local.set $nt (call $triangle_count (local.get $piece)))
    (if (i32.or (i32.lt_s (local.get $n) (i32.const 0)) (i32.lt_s (local.get $nt) (i32.const 0)))
      (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (if (i32.or (i32.le_s (local.get $n) (i32.const 0)) (i32.le_s (local.get $nt) (i32.const 0)))
      (then (return)))
    (if (i32.or (i32.gt_u (local.get $n) (i32.const 1000000)) (i32.gt_u (local.get $nt) (i32.const 1000000)))
      (then (call $log (i32.const 160) (i32.const 35)) (return)))
    (global.set $gn (local.get $n))
    (global.set $gnt (local.get $nt))
    (global.set $gstop (i32.const 0))
    (global.set $gfilled (i32.const 0))
    (global.set $gskipped (i32.const 0))
    (local.set $maxh (i32.trunc_sat_f32_s (call $param (i32.const 0))))
    (if (i32.lt_s (local.get $maxh) (i32.const 3)) (then (local.set $maxh (i32.const 3))))
    (if (i32.gt_s (local.get $maxh) (i32.const 512)) (then (local.set $maxh (i32.const 512))))
    (global.set $guse (f32.ge (call $param (i32.const 1)) (f32.const 0.5)))
    (global.set $gpos (i32.const 16384))
    (global.set $gtri (i32.add (global.get $gpos) (i32.mul (local.get $n) (i32.const 12))))
    (global.set $gmask (i32.add (global.get $gtri) (i32.mul (local.get $nt) (i32.const 12))))
    (global.set $gcol (i32.add (global.get $gmask) (i32.mul (local.get $n) (i32.const 4))))
    (global.set $ggrp (i32.add (global.get $gcol) (i32.mul (local.get $n) (i32.const 12))))
    (global.set $ghid (i32.add (global.get $ggrp) (i32.mul (local.get $nt) (i32.const 4))))
    (local.set $slots (call $pow2 (i32.mul (local.get $nt) (i32.const 8))))
    (if (i32.le_s (local.get $slots) (i32.const 0)) (then (call $log (i32.const 160) (i32.const 35)) (return)))
    (global.set $ghashm (i32.sub (local.get $slots) (i32.const 1)))
    ;; i32 loads trap on an unaligned address, so every table starts on 4 bytes.
    (global.set $ghash
      (i32.and (i32.add (i32.add (global.get $ghid) (local.get $nt)) (i32.const 3)) (i32.const -4)))
    (local.set $edge_cap (i32.mul (local.get $nt) (i32.const 3)))
    (global.set $gedges (i32.add (global.get $ghash) (i32.mul (local.get $slots) (i32.const 12))))
    (global.set $gused (i32.add (global.get $gedges) (i32.mul (local.get $edge_cap) (i32.const 8))))
    (global.set $gfirst (i32.add (global.get $gused) (local.get $edge_cap)))
    ;; first[] must be 4-aligned.
    (global.set $gfirst (i32.and (i32.add (global.get $gfirst) (i32.const 3)) (i32.const -4)))
    (global.set $gout (i32.add (global.get $gfirst) (i32.mul (local.get $n) (i32.const 4))))
    (global.set $gcap (i32.add (local.get $nt) (local.get $edge_cap)))
    (global.set $gogrp (i32.add (global.get $gout) (i32.mul (global.get $gcap) (i32.const 12))))
    (global.set $gohid (i32.add (global.get $gogrp) (i32.mul (global.get $gcap) (i32.const 4))))
    (local.set $end (i32.add (global.get $gohid) (global.get $gcap)))
    (if (i32.eqz (call $ensure (local.get $end)))
      (then (call $log (i32.const 160) (i32.const 35)) (return)))
    (local.set $rc (call $read_positions (local.get $piece) (global.get $gpos) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (local.set $rc (call $read_triangles (local.get $piece) (global.get $gtri) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (local.set $rc (call $read_mask (local.get $piece) (global.get $gmask) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (local.set $rc (call $read_colors (local.get $piece) (global.get $gcol) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (local.set $rc (call $read_groups (local.get $piece) (global.get $ggrp) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (local.set $rc (call $read_hidden (local.get $piece) (global.get $ghid) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 224) (i32.const 22)) (return)))
    (local.set $maxg (i32.const 0))
    (local.set $i (i32.const 0))
    (block $dg (loop $groups
      (br_if $dg (i32.ge_u (local.get $i) (local.get $nt)))
      (local.set $g (i32.load (i32.add (global.get $ggrp) (i32.mul (local.get $i) (i32.const 4)))))
      (if (i32.gt_u (local.get $g) (local.get $maxg)) (then (local.set $maxg (local.get $g))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $groups)))
    (global.set $gnextg (i32.add (local.get $maxg) (i32.const 1)))
    (if (i32.eqz (global.get $gnextg)) (then (global.set $gnextg (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $dh (loop $clear
      (br_if $dh (i32.ge_u (local.get $i) (local.get $slots)))
      (if (i32.eqz (i32.and (local.get $i) (i32.const 65535)))
        (then (if (call $stopped (f32.mul (f32.const 0.2)
          (f32.div (f32.convert_i32_u (local.get $i)) (f32.convert_i32_u (local.get $slots)))))
          (then (return)))))
      (i32.store (i32.add (global.get $ghash) (i32.mul (local.get $i) (i32.const 12))) (i32.const -1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $clear)))
    (local.set $i (i32.const 0))
    (block $dc (loop $count
      (br_if $dc (i32.ge_u (local.get $i) (local.get $nt)))
      (local.set $k (i32.const 0))
      (block $dk (loop $corn
        (br_if $dk (i32.ge_u (local.get $k) (i32.const 3)))
        (call $count_edge
          (call $corner (local.get $i) (local.get $k))
          (call $corner (local.get $i) (i32.rem_u (i32.add (local.get $k) (i32.const 1)) (i32.const 3))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $corn)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $count)))
    (if (global.get $gstop) (then (return)))
    (global.set $gB (i32.const 0))
    (local.set $i (i32.const 0))
    (block $db (loop $bound
      (br_if $db (i32.ge_u (local.get $i) (local.get $nt)))
      (local.set $k (i32.const 0))
      (block $dk2 (loop $corn2
        (br_if $dk2 (i32.ge_u (local.get $k) (i32.const 3)))
        (local.set $a (call $corner (local.get $i) (local.get $k)))
        (local.set $b (call $corner (local.get $i) (i32.rem_u (i32.add (local.get $k) (i32.const 1)) (i32.const 3))))
        (if (i32.and (i32.lt_u (local.get $a) (local.get $n)) (i32.lt_u (local.get $b) (local.get $n)))
          (then
            (if (i32.eq (call $edge_count (local.get $a) (local.get $b)) (i32.const 1))
              (then
                (if (i32.lt_u (global.get $gB) (local.get $edge_cap))
                  (then
                    (i32.store (i32.add (global.get $gedges) (i32.mul (global.get $gB) (i32.const 8))) (local.get $b))
                    (i32.store offset=4 (i32.add (global.get $gedges) (i32.mul (global.get $gB) (i32.const 8))) (local.get $a))
                    (global.set $gB (i32.add (global.get $gB) (i32.const 1)))))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $corn2)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $bound)))
    (if (i32.eqz (global.get $gB))
      (then
        (drop (call $progress (f32.const 1)))
        (call $log_done)
        (return)))
    (if (call $stopped (f32.const 0.4)) (then (return)))
    (call $heapsort (global.get $gB))
    (local.set $i (i32.const 0))
    (block $df (loop $firsts
      (br_if $df (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store (i32.add (global.get $gfirst) (i32.mul (local.get $i) (i32.const 4))) (i32.const -1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $firsts)))
    (local.set $i (i32.const 0))
    (block $du (loop $use
      (br_if $du (i32.ge_u (local.get $i) (global.get $gB)))
      (i32.store8 (i32.add (global.get $gused) (local.get $i)) (i32.const 0))
      (local.set $a (call $efrom (local.get $i)))
      (if (i32.and (i32.lt_u (local.get $a) (local.get $n))
            (i32.eq (i32.load (i32.add (global.get $gfirst) (i32.mul (local.get $a) (i32.const 4)))) (i32.const -1)))
        (then (i32.store (i32.add (global.get $gfirst) (i32.mul (local.get $a) (i32.const 4))) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $use)))
    ;; Copy the piece, then append one patch per closed loop.
    (memory.copy (global.get $gout) (global.get $gtri) (i32.mul (local.get $nt) (i32.const 12)))
    (memory.copy (global.get $gogrp) (global.get $ggrp) (i32.mul (local.get $nt) (i32.const 4)))
    (memory.copy (global.get $gohid) (global.get $ghid) (local.get $nt))
    (global.set $goutn (local.get $nt))
    (local.set $i (i32.const 0))
    (block $dw (loop $walk
      (br_if $dw (i32.ge_u (local.get $i) (global.get $gB)))
      (if (global.get $gstop) (then (return)))
      (if (i32.load8_u (i32.add (global.get $gused) (local.get $i)))
        (then
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $walk)))
      (local.set $v (call $efrom (local.get $i)))
      (local.set $len (i32.const 0))
      (local.set $closed (i32.const 0))
      (local.set $guard (i32.const 0))
      (block $chain (loop $step
        (br_if $chain (i32.gt_u (local.get $guard) (global.get $gB)))
        (local.set $guard (i32.add (local.get $guard) (i32.const 1)))
        (if (i32.ge_u (local.get $v) (local.get $n)) (then (br $chain)))
        (local.set $j (i32.load (i32.add (global.get $gfirst) (i32.mul (local.get $v) (i32.const 4)))))
        (local.set $found (i32.const -1))
        (block $find (loop $scan
          (br_if $find (i32.lt_s (local.get $j) (i32.const 0)))
          (br_if $find (i32.ge_u (local.get $j) (global.get $gB)))
          (br_if $find (i32.ne (call $efrom (local.get $j)) (local.get $v)))
          (if (i32.eqz (i32.load8_u (i32.add (global.get $gused) (local.get $j))))
            (then (local.set $found (local.get $j)) (br $find)))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $scan)))
        (if (i32.lt_s (local.get $found) (i32.const 0)) (then (br $chain)))
        (i32.store8 (i32.add (global.get $gused) (local.get $found)) (i32.const 1))
        (local.set $to (call $eto (local.get $found)))
        (if (i32.eqz (local.get $len))
          (then
            (i32.store (i32.const 1024) (local.get $v))
            (local.set $len (i32.const 1))))
        (if (i32.eq (local.get $to) (i32.load (i32.const 1024)))
          (then (local.set $closed (i32.const 1)) (br $chain)))
        (if (i32.ge_u (local.get $len) (i32.const 512)) (then (br $chain)))
        (i32.store (i32.add (i32.const 1024) (i32.mul (local.get $len) (i32.const 4))) (local.get $to))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))
        (local.set $v (local.get $to))
        (br $step)))
      (if (local.get $closed)
        (then
          (if (i32.le_u (local.get $len) (local.get $maxh))
            (then
              (global.set $gcurg (select (global.get $gnextg) (i32.const 0) (global.get $guse)))
              (call $fill_loop (local.get $len)))
            (else (global.set $gskipped (i32.add (global.get $gskipped) (i32.const 1)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $walk)))
    (if (global.get $gstop) (then (return)))
    (drop (call $progress (f32.const 1)))
    (if (i32.eq (global.get $goutn) (local.get $nt))
      (then (call $log_done) (return)))
    (local.set $rc (call $write_mesh (global.get $gpiece) (global.get $gpos) (local.get $n)
      (global.get $gout) (global.get $goutn)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 288) (i32.const 24)) (return)))
    (local.set $rc (call $write_mask (global.get $gpiece) (global.get $gmask) (local.get $n)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 288) (i32.const 24)) (return)))
    (local.set $rc (call $write_colors (global.get $gpiece) (global.get $gcol) (local.get $n)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 288) (i32.const 24)) (return)))
    (local.set $rc (call $write_groups (global.get $gpiece) (global.get $gogrp) (global.get $goutn)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 288) (i32.const 24)) (return)))
    (local.set $rc (call $write_hidden (global.get $gpiece) (global.get $gohid) (global.get $goutn)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 288) (i32.const 24)) (return)))
    (call $log_done)))
