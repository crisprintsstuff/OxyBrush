{
  "name": "Array",
  "version": "1.0",
  "description": "Makes copies of the active piece in a row along X, Y or Z, each a new piece. For fences, teeth, spines, chains and studs.",
  "api": 2,
  "capabilities": ["read_mesh", "add_pieces"],
  "commands": [
    { "id": "x", "label": "Copies along X" },
    { "id": "y", "label": "Copies along Y" },
    { "id": "z", "label": "Copies along Z" }
  ],
  "params": [
    { "id": "copies", "label": "Copies", "min": 1.0, "max": 20.0, "default": 3.0 },
    { "id": "gap", "label": "Gap (% of size)", "min": -90.0, "max": 300.0, "default": 20.0 }
  ]
}
