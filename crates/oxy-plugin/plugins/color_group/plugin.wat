;; Color by Group: an in-app OxyBrush plugin in WebAssembly text (API 3).
;; Paints vertex color from face groups. "Selected group" blends vertices
;; that touch that group toward the chosen color. "Every group" gives each
;; group its own color (group 0 stays white, the selected group uses the
;; color you picked) and blends a vertex by the groups of the faces around
;; it. The mask scales the blend, so a fully masked vertex is unchanged.
;;
;; Shows: a choice, a whole-number slider, param_color, a strength slider,
;; read_groups, write_colors, the mask, live preview, and progress / Stop.
;;
;; Memory: the picked color is read at 256. Triangles at 1024, then groups,
;; mask, the colors read (and written back), and a running sum per vertex
;; (r, g, b and a count).
(module
  (import "oxybrush" "log" (func $log (param i32 i32)))
  (import "oxybrush" "param" (func $param (param i32) (result f32)))
  (import "oxybrush" "param_color" (func $param_color (param i32 i32) (result i32)))
  (import "oxybrush" "active_piece" (func $active (result i32)))
  (import "oxybrush" "vertex_count" (func $vertex_count (param i32) (result i32)))
  (import "oxybrush" "triangle_count" (func $triangle_count (param i32) (result i32)))
  (import "oxybrush" "read_triangles" (func $read_triangles (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_groups" (func $read_groups (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_mask" (func $read_mask (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_colors" (func $read_colors (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_colors" (func $write_colors (param i32 i32 i32) (result i32)))
  (import "oxybrush" "progress" (func $progress (param f32) (result i32)))

  (memory (export "memory") 1)
  (data (i32.const 0) "Colored by face group")
  (data (i32.const 64) "The piece is too large for a plugin")
  (data (i32.const 128) "Couldn't read the mesh")
  (data (i32.const 192) "Couldn't change the mesh")

  (global $gsel (mut i32) (i32.const 0))
  (global $gevery (mut i32) (i32.const 0))
  (global $cr (mut f32) (f32.const 1))
  (global $cg (mut f32) (f32.const 1))
  (global $cb (mut f32) (f32.const 1))

  (func $ensure (param $end i32) (result i32)
    (local $need i32)
    (if (i32.lt_s (local.get $end) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $need (i32.div_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 65536)))
    (if (i32.gt_u (local.get $need) (memory.size))
      (then
        (if (i32.eq (memory.grow (i32.sub (local.get $need) (memory.size))) (i32.const -1))
          (then (return (i32.const 0))))))
    (i32.const 1))

  (func $frac (param $x f32) (result f32)
    (local $w f32)
    (local.set $w (f32.sub (local.get $x) (f32.floor (local.get $x))))
    (if (f32.lt (local.get $w) (f32.const 0))
      (then (local.set $w (f32.add (local.get $w) (f32.const 1)))))
    (local.get $w))

  ;; Hue 0..=1, saturation 0.72, value 0.95, written as three f32 at `dst`.
  (func $hsv (param $h f32) (param $dst i32)
    (local $f f32) (local $i i32) (local $p f32) (local $q f32) (local $t f32)
    (local $r f32) (local $g f32) (local $b f32)
    (local.set $h (call $frac (local.get $h)))
    (local.set $f (f32.mul (local.get $h) (f32.const 6)))
    (local.set $i (i32.trunc_f32_u (local.get $f)))
    (if (i32.gt_u (local.get $i) (i32.const 5)) (then (local.set $i (i32.const 5))))
    (local.set $f (f32.sub (local.get $f) (f32.convert_i32_u (local.get $i))))
    (local.set $p (f32.const 0.266))
    (local.set $q (f32.mul (f32.const 0.95) (f32.sub (f32.const 1) (f32.mul (local.get $f) (f32.const 0.72)))))
    (local.set $t (f32.mul (f32.const 0.95)
      (f32.sub (f32.const 1) (f32.mul (f32.sub (f32.const 1) (local.get $f)) (f32.const 0.72)))))
    (if (i32.eq (local.get $i) (i32.const 0))
      (then (local.set $r (f32.const 0.95)) (local.set $g (local.get $t)) (local.set $b (local.get $p))))
    (if (i32.eq (local.get $i) (i32.const 1))
      (then (local.set $r (local.get $q)) (local.set $g (f32.const 0.95)) (local.set $b (local.get $p))))
    (if (i32.eq (local.get $i) (i32.const 2))
      (then (local.set $r (local.get $p)) (local.set $g (f32.const 0.95)) (local.set $b (local.get $t))))
    (if (i32.eq (local.get $i) (i32.const 3))
      (then (local.set $r (local.get $p)) (local.set $g (local.get $q)) (local.set $b (f32.const 0.95))))
    (if (i32.eq (local.get $i) (i32.const 4))
      (then (local.set $r (local.get $t)) (local.set $g (local.get $p)) (local.set $b (f32.const 0.95))))
    (if (i32.eq (local.get $i) (i32.const 5))
      (then (local.set $r (f32.const 0.95)) (local.set $g (local.get $p)) (local.set $b (local.get $q))))
    (f32.store (local.get $dst) (local.get $r))
    (f32.store offset=4 (local.get $dst) (local.get $g))
    (f32.store offset=8 (local.get $dst) (local.get $b)))

  ;; Color of face group `g` at `dst` (three f32). Group 0 is white; the
  ;; group the user picked uses their color; any other group gets a hue.
  (func $color_of (param $g i32) (param $dst i32)
    (if (i32.or (i32.eqz (global.get $gevery)) (i32.eq (local.get $g) (global.get $gsel)))
      (then
        (f32.store (local.get $dst) (global.get $cr))
        (f32.store offset=4 (local.get $dst) (global.get $cg))
        (f32.store offset=8 (local.get $dst) (global.get $cb))
        (return)))
    (if (i32.eqz (local.get $g))
      (then
        (f32.store (local.get $dst) (f32.const 1))
        (f32.store offset=4 (local.get $dst) (f32.const 1))
        (f32.store offset=8 (local.get $dst) (f32.const 1))
        (return)))
    (call $hsv
      (call $frac (f32.mul (f32.convert_i32_u (local.get $g)) (f32.const 0.618034)))
      (local.get $dst)))

  (func (export "run") (param $command i32)
    (local $piece i32) (local $n i32) (local $nt i32)
    (local $tris i32) (local $groups i32) (local $mask i32) (local $colors i32) (local $acc i32)
    (local $i i32) (local $k i32) (local $p i32) (local $v i32) (local $g i32)
    (local $rc i32) (local $w f32) (local $m f32) (local $cnt f32) (local $strength f32)
    (if (call $progress (f32.const 0)) (then (return)))
    (local.set $piece (call $active))
    (local.set $n (call $vertex_count (local.get $piece)))
    (local.set $nt (call $triangle_count (local.get $piece)))
    (if (i32.or (i32.lt_s (local.get $n) (i32.const 0)) (i32.lt_s (local.get $nt) (i32.const 0)))
      (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (if (i32.or (i32.le_s (local.get $n) (i32.const 0)) (i32.le_s (local.get $nt) (i32.const 0)))
      (then (return)))
    (if (i32.or (i32.gt_u (local.get $n) (i32.const 2000000)) (i32.gt_u (local.get $nt) (i32.const 2000000)))
      (then (call $log (i32.const 64) (i32.const 35)) (return)))
    (local.set $rc (call $param_color (i32.const 2) (i32.const 256)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (global.set $cr (f32.load (i32.const 256)))
    (global.set $cg (f32.load offset=4 (i32.const 256)))
    (global.set $cb (f32.load offset=8 (i32.const 256)))
    (global.set $gevery (f32.ge (call $param (i32.const 0)) (f32.const 0.5)))
    (global.set $gsel (i32.trunc_sat_f32_s (call $param (i32.const 1))))
    (if (i32.lt_s (global.get $gsel) (i32.const 0)) (then (global.set $gsel (i32.const 0))))
    (if (i32.gt_s (global.get $gsel) (i32.const 256)) (then (global.set $gsel (i32.const 256))))
    (local.set $strength (call $param (i32.const 3)))
    (local.set $tris (i32.const 1024))
    (local.set $groups (i32.add (local.get $tris) (i32.mul (local.get $nt) (i32.const 12))))
    (local.set $mask (i32.add (local.get $groups) (i32.mul (local.get $nt) (i32.const 4))))
    (local.set $colors (i32.add (local.get $mask) (i32.mul (local.get $n) (i32.const 4))))
    (local.set $acc (i32.add (local.get $colors) (i32.mul (local.get $n) (i32.const 12))))
    (if (i32.eqz (call $ensure (i32.add (local.get $acc) (i32.mul (local.get $n) (i32.const 16)))))
      (then (call $log (i32.const 64) (i32.const 35)) (return)))
    (local.set $rc (call $read_triangles (local.get $piece) (local.get $tris) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $rc (call $read_groups (local.get $piece) (local.get $groups) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $rc (call $read_mask (local.get $piece) (local.get $mask) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $rc (call $read_colors (local.get $piece) (local.get $colors) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $i (i32.const 0))
    (block $za (loop $zero
      (br_if $za (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $p (i32.add (local.get $acc) (i32.mul (local.get $i) (i32.const 16))))
      (f32.store (local.get $p) (f32.const 0))
      (f32.store offset=4 (local.get $p) (f32.const 0))
      (f32.store offset=8 (local.get $p) (f32.const 0))
      (f32.store offset=12 (local.get $p) (f32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $zero)))
    (local.set $i (i32.const 0))
    (block $dt (loop $tris
      (br_if $dt (i32.ge_u (local.get $i) (local.get $nt)))
      (if (i32.eqz (i32.and (local.get $i) (i32.const 65535)))
        (then
          (if (call $progress (f32.mul (f32.const 0.7)
                (f32.div (f32.convert_i32_u (local.get $i)) (f32.convert_i32_u (local.get $nt)))))
            (then (return)))))
      (local.set $g (i32.load (i32.add (local.get $groups) (i32.mul (local.get $i) (i32.const 4)))))
      (if (i32.and (i32.eqz (global.get $gevery)) (i32.ne (local.get $g) (global.get $gsel)))
        (then
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $tris)))
      (call $color_of (local.get $g) (i32.const 768))
      (local.set $p (i32.add (local.get $tris) (i32.mul (local.get $i) (i32.const 12))))
      (local.set $k (i32.const 0))
      (block $dk (loop $corn
        (br_if $dk (i32.ge_u (local.get $k) (i32.const 3)))
        (local.set $v (i32.load (i32.add (local.get $p) (i32.mul (local.get $k) (i32.const 4)))))
        (if (i32.lt_u (local.get $v) (local.get $n))
          (then
            (local.set $v (i32.add (local.get $acc) (i32.mul (local.get $v) (i32.const 16))))
            (f32.store (local.get $v) (f32.add (f32.load (local.get $v)) (f32.load (i32.const 768))))
            (f32.store offset=4 (local.get $v)
              (f32.add (f32.load offset=4 (local.get $v)) (f32.load offset=4 (i32.const 768))))
            (f32.store offset=8 (local.get $v)
              (f32.add (f32.load offset=8 (local.get $v)) (f32.load offset=8 (i32.const 768))))
            (f32.store offset=12 (local.get $v) (f32.add (f32.load offset=12 (local.get $v)) (f32.const 1)))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $corn)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $tris)))
    (local.set $i (i32.const 0))
    (block $dc (loop $blend
      (br_if $dc (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $p (i32.add (local.get $acc) (i32.mul (local.get $i) (i32.const 16))))
      (local.set $cnt (f32.load offset=12 (local.get $p)))
      (if (f32.gt (local.get $cnt) (f32.const 0))
        (then
          (local.set $m (f32.load (i32.add (local.get $mask) (i32.mul (local.get $i) (i32.const 4)))))
          (local.set $w (f32.mul (local.get $strength) (f32.sub (f32.const 1) (local.get $m))))
          (if (f32.lt (local.get $w) (f32.const 0)) (then (local.set $w (f32.const 0))))
          (if (f32.gt (local.get $w) (f32.const 1)) (then (local.set $w (f32.const 1))))
          (if (f32.gt (local.get $w) (f32.const 0))
            (then
              (local.set $v (i32.add (local.get $colors) (i32.mul (local.get $i) (i32.const 12))))
              (f32.store (local.get $v)
                (f32.add (f32.mul (f32.load (local.get $v)) (f32.sub (f32.const 1) (local.get $w)))
                         (f32.mul (f32.div (f32.load (local.get $p)) (local.get $cnt)) (local.get $w))))
              (f32.store offset=4 (local.get $v)
                (f32.add (f32.mul (f32.load offset=4 (local.get $v)) (f32.sub (f32.const 1) (local.get $w)))
                         (f32.mul (f32.div (f32.load offset=4 (local.get $p)) (local.get $cnt)) (local.get $w))))
              (f32.store offset=8 (local.get $v)
                (f32.add (f32.mul (f32.load offset=8 (local.get $v)) (f32.sub (f32.const 1) (local.get $w)))
                         (f32.mul (f32.div (f32.load offset=8 (local.get $p)) (local.get $cnt)) (local.get $w))))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $blend)))
    (drop (call $progress (f32.const 1)))
    (local.set $rc (call $write_colors (local.get $piece) (local.get $colors) (local.get $n)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 192) (i32.const 24)) (return)))
    (call $log (i32.const 0) (i32.const 21))))
