;; Hide Faces by Angle: an in-app OxyBrush plugin in WebAssembly text (API 3).
;; Hides a triangle when the angle between its normal and a chosen axis is
;; past a threshold (or the other way round, with Invert). A face whose
;; vertices are mostly masked keeps the visibility it already had, which is
;; why the old flags are read before they are written.
;;
;; Shows: a choice, a stepped slider, toggles, read_hidden and write_hidden,
;; live preview, the mask, and progress / Stop.
;;
;; Memory: positions at 1024, then triangles, mask, and one byte of visibility
;; per triangle (read, then overwritten in place).
(module
  (import "oxybrush" "log" (func $log (param i32 i32)))
  (import "oxybrush" "param" (func $param (param i32) (result f32)))
  (import "oxybrush" "active_piece" (func $active (result i32)))
  (import "oxybrush" "vertex_count" (func $vertex_count (param i32) (result i32)))
  (import "oxybrush" "triangle_count" (func $triangle_count (param i32) (result i32)))
  (import "oxybrush" "read_positions" (func $read_positions (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_triangles" (func $read_triangles (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_mask" (func $read_mask (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_hidden" (func $read_hidden (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_hidden" (func $write_hidden (param i32 i32 i32) (result i32)))
  (import "oxybrush" "progress" (func $progress (param f32) (result i32)))

  (memory (export "memory") 1)
  (data (i32.const 0) "Hid faces by angle")
  (data (i32.const 64) "The piece is too large for a plugin")
  (data (i32.const 128) "Couldn't read the mesh")
  (data (i32.const 192) "Couldn't change the mesh")

  (func $ensure (param $end i32) (result i32)
    (local $need i32)
    (if (i32.lt_s (local.get $end) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $need (i32.div_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 65536)))
    (if (i32.gt_u (local.get $need) (memory.size))
      (then
        (if (i32.eq (memory.grow (i32.sub (local.get $need) (memory.size))) (i32.const -1))
          (then (return (i32.const 0))))))
    (i32.const 1))

  (func $cos_deg (param $deg f32) (result f32)
    (local $x2 f32) (local $y f32)
    (local.set $x2 (f32.mul (local.get $deg) (f32.const 0.017453292)))
    (local.set $x2 (f32.mul (local.get $x2) (local.get $x2)))
    (local.set $y (f32.const -1.1470746e-11))
    (local.set $y (f32.add (f32.const 2.0876757e-9) (f32.mul (local.get $x2) (local.get $y))))
    (local.set $y (f32.add (f32.const -2.7557319e-7) (f32.mul (local.get $x2) (local.get $y))))
    (local.set $y (f32.add (f32.const 2.4801587e-5) (f32.mul (local.get $x2) (local.get $y))))
    (local.set $y (f32.add (f32.const -0.0013888889) (f32.mul (local.get $x2) (local.get $y))))
    (local.set $y (f32.add (f32.const 0.041666668) (f32.mul (local.get $x2) (local.get $y))))
    (local.set $y (f32.add (f32.const -0.5) (f32.mul (local.get $x2) (local.get $y))))
    (f32.add (f32.const 1) (f32.mul (local.get $x2) (local.get $y))))

  (func $coord (param $pos i32) (param $v i32) (param $axis i32) (result f32)
    (f32.load (i32.add (local.get $pos)
      (i32.add (i32.mul (local.get $v) (i32.const 12)) (i32.mul (local.get $axis) (i32.const 4))))))

  (func $mask_at (param $mask i32) (param $v i32) (result f32)
    (f32.load (i32.add (local.get $mask) (i32.mul (local.get $v) (i32.const 4)))))

  (func (export "run") (param $command i32)
    (local $piece i32) (local $n i32) (local $nt i32)
    (local $tris i32) (local $mask i32) (local $hidden i32)
    (local $axis i32) (local $deg i32) (local $invert i32) (local $protect i32)
    (local $t i32) (local $p i32) (local $a i32) (local $b i32) (local $c i32)
    (local $cos f32) (local $ux f32) (local $uy f32) (local $uz f32)
    (local $vx f32) (local $vy f32) (local $vz f32)
    (local $nx f32) (local $ny f32) (local $nz f32) (local $len f32) (local $dot f32)
    (local $hide i32) (local $rc i32)
    (if (call $progress (f32.const 0)) (then (return)))
    (local.set $piece (call $active))
    (local.set $n (call $vertex_count (local.get $piece)))
    (local.set $nt (call $triangle_count (local.get $piece)))
    (if (i32.or (i32.lt_s (local.get $n) (i32.const 0)) (i32.lt_s (local.get $nt) (i32.const 0)))
      (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (if (i32.or (i32.le_s (local.get $n) (i32.const 0)) (i32.le_s (local.get $nt) (i32.const 0)))
      (then (return)))
    (if (i32.or (i32.gt_u (local.get $n) (i32.const 2000000)) (i32.gt_u (local.get $nt) (i32.const 2000000)))
      (then (call $log (i32.const 64) (i32.const 35)) (return)))
    (local.set $tris (i32.add (i32.const 1024) (i32.mul (local.get $n) (i32.const 12))))
    (local.set $mask (i32.add (local.get $tris) (i32.mul (local.get $nt) (i32.const 12))))
    (local.set $hidden (i32.add (local.get $mask) (i32.mul (local.get $n) (i32.const 4))))
    (if (i32.eqz (call $ensure (i32.add (local.get $hidden) (local.get $nt))))
      (then (call $log (i32.const 64) (i32.const 35)) (return)))
    (local.set $rc (call $read_positions (local.get $piece) (i32.const 1024) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $rc (call $read_triangles (local.get $piece) (local.get $tris) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $rc (call $read_mask (local.get $piece) (local.get $mask) (local.get $n)))
    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $rc (call $read_hidden (local.get $piece) (local.get $hidden) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 128) (i32.const 22)) (return)))
    (local.set $axis (i32.trunc_sat_f32_s (call $param (i32.const 0))))
    (if (i32.lt_s (local.get $axis) (i32.const 0)) (then (local.set $axis (i32.const 1))))
    (if (i32.gt_s (local.get $axis) (i32.const 2)) (then (local.set $axis (i32.const 1))))
    (local.set $deg (i32.trunc_sat_f32_s (call $param (i32.const 1))))
    (if (i32.lt_s (local.get $deg) (i32.const 0)) (then (local.set $deg (i32.const 0))))
    (if (i32.gt_s (local.get $deg) (i32.const 180)) (then (local.set $deg (i32.const 180))))
    (local.set $cos (call $cos_deg (f32.convert_i32_s (local.get $deg))))
    (local.set $invert (f32.ge (call $param (i32.const 2)) (f32.const 0.5)))
    (local.set $protect (f32.ge (call $param (i32.const 3)) (f32.const 0.5)))
    (local.set $t (i32.const 0))
    (block $done (loop $each
      (br_if $done (i32.ge_u (local.get $t) (local.get $nt)))
      (if (i32.eqz (i32.and (local.get $t) (i32.const 65535)))
        (then
          (if (call $progress (f32.div (f32.convert_i32_u (local.get $t)) (f32.convert_i32_u (local.get $nt))))
            (then (return)))))
      (local.set $p (i32.add (local.get $tris) (i32.mul (local.get $t) (i32.const 12))))
      (local.set $a (i32.load (local.get $p)))
      (local.set $b (i32.load offset=4 (local.get $p)))
      (local.set $c (i32.load offset=8 (local.get $p)))
      ;; Protected when the three masks add up to at least 1.5 (average 0.5).
      (if (i32.and (local.get $protect)
            (f32.ge
              (f32.add (call $mask_at (local.get $mask) (local.get $a))
                (f32.add (call $mask_at (local.get $mask) (local.get $b))
                         (call $mask_at (local.get $mask) (local.get $c))))
              (f32.const 1.5)))
        (then
          (local.set $t (i32.add (local.get $t) (i32.const 1)))
          (br $each)))
      (local.set $ux (f32.sub (call $coord (i32.const 1024) (local.get $b) (i32.const 0))
                              (call $coord (i32.const 1024) (local.get $a) (i32.const 0))))
      (local.set $uy (f32.sub (call $coord (i32.const 1024) (local.get $b) (i32.const 1))
                              (call $coord (i32.const 1024) (local.get $a) (i32.const 1))))
      (local.set $uz (f32.sub (call $coord (i32.const 1024) (local.get $b) (i32.const 2))
                              (call $coord (i32.const 1024) (local.get $a) (i32.const 2))))
      (local.set $vx (f32.sub (call $coord (i32.const 1024) (local.get $c) (i32.const 0))
                              (call $coord (i32.const 1024) (local.get $a) (i32.const 0))))
      (local.set $vy (f32.sub (call $coord (i32.const 1024) (local.get $c) (i32.const 1))
                              (call $coord (i32.const 1024) (local.get $a) (i32.const 1))))
      (local.set $vz (f32.sub (call $coord (i32.const 1024) (local.get $c) (i32.const 2))
                              (call $coord (i32.const 1024) (local.get $a) (i32.const 2))))
      (local.set $nx (f32.sub (f32.mul (local.get $uy) (local.get $vz)) (f32.mul (local.get $uz) (local.get $vy))))
      (local.set $ny (f32.sub (f32.mul (local.get $uz) (local.get $vx)) (f32.mul (local.get $ux) (local.get $vz))))
      (local.set $nz (f32.sub (f32.mul (local.get $ux) (local.get $vy)) (f32.mul (local.get $uy) (local.get $vx))))
      (local.set $len (f32.sqrt (f32.add (f32.mul (local.get $nx) (local.get $nx))
        (f32.add (f32.mul (local.get $ny) (local.get $ny)) (f32.mul (local.get $nz) (local.get $nz))))))
      ;; A degenerate face keeps whatever visibility it had.
      (if (f32.ge (local.get $len) (f32.const 1e-12))
        (then
          (if (i32.eq (local.get $axis) (i32.const 0))
            (then (local.set $dot (f32.div (local.get $nx) (local.get $len))))
            (else
              (if (i32.eq (local.get $axis) (i32.const 2))
                (then (local.set $dot (f32.div (local.get $nz) (local.get $len))))
                (else (local.set $dot (f32.div (local.get $ny) (local.get $len)))))))
          ;; angle > threshold is dot < cos. Invert hides the rest (dot >= cos).
          (local.set $hide (f32.lt (local.get $dot) (local.get $cos)))
          (if (local.get $invert) (then (local.set $hide (i32.eqz (local.get $hide)))))
          (i32.store8 (i32.add (local.get $hidden) (local.get $t)) (local.get $hide))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $each)))
    (drop (call $progress (f32.const 1)))
    (local.set $rc (call $write_hidden (local.get $piece) (local.get $hidden) (local.get $nt)))
    (if (i32.lt_s (local.get $rc) (i32.const 0))
      (then (call $log (i32.const 192) (i32.const 24)) (return)))
    (call $log (i32.const 0) (i32.const 18))))
