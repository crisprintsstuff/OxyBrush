  (func (export "run") (param $command i32)
    (local $piece i32) (local $n i32) (local $nt i32) (local $rc i32)
    (local $amount i32) (local $keep i32) (local $bound i32) (local $groups i32) (local $pmask i32)
    (local $slots i32) (local $hcap i32) (local $end i32)
