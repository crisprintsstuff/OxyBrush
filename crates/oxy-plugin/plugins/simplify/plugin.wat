      (br_if $up (i32.eqz (local.get $i)))
      (local.set $parent (i32.shr_u (i32.sub (local.get $i) (i32.const 1)) (i32.const 1)))
      (local.set $pk (call $hkey (local.get $parent)))
      (br_if $up (i32.le_u (local.get $pk) (local.get $key)))
      (call $hset (local.get $i) (local.get $pk) (call $hslot (local.get $parent)))
      (local.set $i (local.get $parent))
      (br $sift)))
