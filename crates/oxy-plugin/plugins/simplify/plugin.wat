      (i32.and (call $locked (local.get $a)) (call $locked (local.get $b)))
      (i32.and (call $locked (local.get $b)) (call $locked (local.get $c))))
      (i32.and (call $locked (local.get $c)) (call $locked (local.get $a)))))

  (func $drops_border (param $a i32) (param $b i32) (result i32)
    (local $node i32) (local $t i32)
