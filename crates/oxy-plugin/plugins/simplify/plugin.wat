    (if (i32.ne (local.get $rc) (local.get $n)) (then (call $log (i32.const 192) (i32.const 22)) (return)))
    (local.set $rc (call $read_groups (local.get $piece) (global.get $ggrp) (local.get $nt)))
    (if (i32.ne (local.get $rc) (local.get $nt)) (then (call $log (i32.const 192) (i32.const 22)) (return)))
    (local.set $rc (call $read_hidden (local.get $piece) (global.get $ghid) (local.get $nt)))
