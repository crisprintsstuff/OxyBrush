                  (f32.load (i32.add (local.get $pa) (i32.mul (local.get $i) (i32.const 4))))
                  (f32.load (i32.add (local.get $pb) (i32.mul (local.get $i) (i32.const 4)))))
                  (f32.const 0.5)))
