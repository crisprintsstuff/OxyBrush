  (func $pop (result i32)
    (local $idx i32) (local $n i32) (local $last i32)
    (if (i32.eqz (global.get $ghn)) (then (return (i32.const -1))))
    (local.set $idx (call $hslot (i32.const 0)))
    (global.set $ghn (i32.sub (global.get $ghn) (i32.const 1)))
    (local.set $n (global.get $ghn))
    (if (i32.gt_u (local.get $n) (i32.const 0))
      (then
        (local.set $last (local.get $n))
        (call $hset (i32.const 0) (call $hkey (local.get $last)) (call $hslot (local.get $last)))
        (call $siftdown (i32.const 0))))
    (local.get $idx))

  (func $pay (param $idx i32) (param $field i32) (result i32)
    (i32.load (i32.add (i32.add (global.get $gpay) (i32.mul (local.get $idx) (i32.const 16)))
      (i32.mul (local.get $field) (i32.const 4)))))

  (func $queue_edge (param $a i32) (param $b i32)
    (if (call $best (local.get $a) (local.get $b))
      (then (call $push (global.get $gcost) (local.get $a) (local.get $b)
        (call $stamp (local.get $a)) (call $stamp (local.get $b))))))

  (func $try (param $a i32) (param $b i32) (param $sa i32) (param $sb i32) (result i32)
    (local $tmp i32) (local $na i32) (local $nb i32) (local $shared i32)
    (local $i i32) (local $j i32) (local $u i32) (local $t i32) (local $count i32)
    (if (i32.or (i32.ne (call $stamp (local.get $a)) (local.get $sa))
                (i32.ne (call $stamp (local.get $b)) (local.get $sb)))
      (then (return (i32.const 0))))
    (if (i32.and (call $locked (local.get $a)) (call $locked (local.get $b)))
      (then (return (i32.const 0))))
    (if (i32.and (call $locked (local.get $b)) (i32.eqz (call $locked (local.get $a))))
      (then
        (local.set $tmp (local.get $a))
        (local.set $a (local.get $b))
        (local.set $b (local.get $tmp))))
    (if (i32.eqz (call $best (local.get $a) (local.get $b))) (then (return (i32.const 0))))
    (if (i32.eqz (call $has_edge (local.get $a) (local.get $b))) (then (return (i32.const 0))))
    (local.set $na (call $ring (local.get $a) (i32.const 2304)))
    (if (i32.eq (local.get $na) (i32.const 255)) (then (return (i32.const 0))))
    (local.set $nb (call $ring (local.get $b) (i32.const 2688)))
    (if (i32.eq (local.get $nb) (i32.const 255)) (then (return (i32.const 0))))
    (local.set $shared (i32.const 0))
    (local.set $i (i32.const 0))
    (block $ds (loop $ss
      (br_if $ds (i32.ge_u (local.get $i) (local.get $na)))
      (local.set $u (i32.load (i32.add (i32.const 2304) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $j (i32.const 0))
      (block $db (loop $bb
        (br_if $db (i32.ge_u (local.get $j) (local.get $nb)))
        (if (i32.eq (local.get $u) (i32.load (i32.add (i32.const 2688) (i32.mul (local.get $j) (i32.const 4)))))
          (then (local.set $shared (i32.add (local.get $shared) (i32.const 1))) (br $db)))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $bb)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $ss)))
    (if (i32.ne (local.get $shared) (i32.const 2)) (then (return (i32.const 0))))
    (if (call $drops_border (local.get $a) (local.get $b)) (then (return (i32.const 0))))
    (if (call $flips (local.get $a) (local.get $b)) (then (return (i32.const 0))))
    (if (call $flips (local.get $b) (local.get $a)) (then (return (i32.const 0))))
    (local.set $count (call $collect (local.get $b) (i32.const 3072)))
    (if (i32.eq (local.get $count) (i32.const 255)) (then (return (i32.const 0))))
    (call $apply_vertex (local.get $a) (local.get $b))
    (local.set $i (i32.const 0))
    (block $dt (loop $tt
      (br_if $dt (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $t (i32.load (i32.add (i32.const 3072) (i32.mul (local.get $i) (i32.const 4)))))
      (if (call $alive (local.get $t))
        (then
          (if (call $tri_has (local.get $t) (local.get $a))
            (then (call $kill (local.get $t)))
            (else (call $rewire (local.get $t) (local.get $a) (local.get $b))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $tt)))
