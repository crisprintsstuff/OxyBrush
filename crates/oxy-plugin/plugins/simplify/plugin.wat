          (then
            (f32.store (local.get $pa) (f32.load (local.get $pb)))
            (f32.store offset=4 (local.get $pa) (f32.load offset=4 (local.get $pb)))
            (f32.store offset=8 (local.get $pa) (f32.load offset=8 (local.get $pb))))
