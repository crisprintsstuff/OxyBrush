              (if (i32.ge_u (local.get $n) (i32.const 96)) (then (return (i32.const 255))))
              (i32.store (i32.add (local.get $dst) (i32.mul (local.get $n) (i32.const 4))) (local.get $t))
              (local.set $n (i32.add (local.get $n) (i32.const 1)))))))
