      (f32.add (f32.mul (local.get $dy) (local.get $dy)) (f32.mul (local.get $dz) (local.get $dz)))))

  (func $apply_vertex (param $a i32) (param $b i32)
    (local $da f32) (local $db f32) (local $pa i32) (local $pb i32) (local $i i32)
    (local.set $da (call $dist2 (local.get $a)))
    (local.set $db (call $dist2 (local.get $b)))
    (local.set $pa (i32.add (global.get $gcol) (i32.mul (local.get $a) (i32.const 12))))
    (local.set $pb (i32.add (global.get $gcol) (i32.mul (local.get $b) (i32.const 12))))
