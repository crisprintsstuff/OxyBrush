;; Simplify Mesh: an in-app OxyBrush plugin in WebAssembly text (API 3).
;; Quadric-error edge collapse (Garland & Heckbert, "Surface Simplification
;; Using Quadric Error Metrics", 1997). Each edge's cost is the quadric
;; error of the cheaper of its endpoints and its midpoint. A collapse that
;; would flip a triangle, break the link condition, or delete an open edge
;; or a face-group border is refused, and a fully masked vertex is not
;; moved. After write_mesh the piece would otherwise come back unmasked,
;; white and in group 0, so mask, color, groups and hidden flags are written
;; back for what remains.
;;
;; Not a live preview: collapsing is too much work to repeat on every
;; slider tick. Progress is reported and Stop returns before a write. A
;; piece past 80,000 triangles is refused; one that cannot be finished
;; inside the instruction budget is only partly simplified.
;;
;; Scratch lives below 4096 (quadric sum, a triangle's corners, neighbour
;; lists). The mesh copy starts at 4096.
(module
  (import "oxybrush" "log" (func $log (param i32 i32)))
  (import "oxybrush" "param" (func $param (param i32) (result f32)))
  (import "oxybrush" "active_piece" (func $active (result i32)))
  (import "oxybrush" "vertex_count" (func $vertex_count (param i32) (result i32)))
  (import "oxybrush" "triangle_count" (func $triangle_count (param i32) (result i32)))
  (import "oxybrush" "read_positions" (func $read_positions (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_triangles" (func $read_triangles (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_mask" (func $read_mask (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_colors" (func $read_colors (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_groups" (func $read_groups (param i32 i32 i32) (result i32)))
  (import "oxybrush" "read_hidden" (func $read_hidden (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_mesh" (func $write_mesh (param i32 i32 i32 i32 i32) (result i32)))
  (import "oxybrush" "write_mask" (func $write_mask (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_colors" (func $write_colors (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_groups" (func $write_groups (param i32 i32 i32) (result i32)))
  (import "oxybrush" "write_hidden" (func $write_hidden (param i32 i32 i32) (result i32)))
  (import "oxybrush" "progress" (func $progress (param f32) (result i32)))

  (memory (export "memory") 1)
  (data (i32.const 0) "Nothing to remove")
  (data (i32.const 32) "Removed ")
  (data (i32.const 48) " triangles")
  (data (i32.const 64) " (run again to simplify more)")
  (data (i32.const 128) "The piece is too large for a plugin")
  (data (i32.const 192) "Couldn't read the mesh")
  (data (i32.const 256) "Couldn't change the mesh")
  (data (i32.const 288) "Couldn't simplify this piece")

  (global $gpos (mut i32) (i32.const 0))
  (global $gtri (mut i32) (i32.const 0))
  (global $gmask (mut i32) (i32.const 0))
  (global $gcol (mut i32) (i32.const 0))
  (global $ggrp (mut i32) (i32.const 0))
  (global $ghid (mut i32) (i32.const 0))
  (global $galive (mut i32) (i32.const 0))
  (global $glock (mut i32) (i32.const 0))
  (global $gstamp (mut i32) (i32.const 0))
  (global $ghead (mut i32) (i32.const 0))
  (global $gpool (mut i32) (i32.const 0))
  (global $gquad (mut i32) (i32.const 0))
  (global $ghash (mut i32) (i32.const 0))
  (global $ghashm (mut i32) (i32.const 0))
  (global $ghkey (mut i32) (i32.const 0))
  (global $ghslot (mut i32) (i32.const 0))
  (global $ghn (mut i32) (i32.const 0))
  (global $ghcap (mut i32) (i32.const 0))
  (global $gpay (mut i32) (i32.const 0))
  (global $gpayn (mut i32) (i32.const 0))
  (global $gpaycap (mut i32) (i32.const 0))
  (global $goutp (mut i32) (i32.const 0))
  (global $goutm (mut i32) (i32.const 0))
  (global $goutc (mut i32) (i32.const 0))
  (global $goutt (mut i32) (i32.const 0))
  (global $goutg (mut i32) (i32.const 0))
  (global $gouth (mut i32) (i32.const 0))
  (global $gn (mut i32) (i32.const 0))
  (global $gnt (mut i32) (i32.const 0))
  (global $galive_n (mut i32) (i32.const 0))
  (global $gtarget (mut i32) (i32.const 0))
  (global $gpiece (mut i32) (i32.const 0))
  (global $gstop (mut i32) (i32.const 0))
  (global $gdid (mut i32) (i32.const 0))
  (global $ghave (mut i32) (i32.const 0))
  (global $gtx (mut f32) (f32.const 0))
  (global $gty (mut f32) (f32.const 0))
  (global $gtz (mut f32) (f32.const 0))
  (global $gcost (mut f32) (f32.const 0))
  (global $gnewn (mut i32) (i32.const 0))
  (global $gnewnt (mut i32) (i32.const 0))

  (func $ensure (param $end i32) (result i32)
    (local $need i32)
    (if (i32.lt_s (local.get $end) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $need (i32.div_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 65536)))
    (if (i32.gt_u (local.get $need) (memory.size))
      (then
        (if (i32.eq (memory.grow (i32.sub (local.get $need) (memory.size))) (i32.const -1))
          (then (return (i32.const 0))))))
    (i32.const 1))

  (func $align4 (param $x i32) (result i32)
    (i32.and (i32.add (local.get $x) (i32.const 3)) (i32.const -4)))

  (func $pow2 (param $n i32) (result i32)
    (local $p i32)
    (if (i32.lt_u (local.get $n) (i32.const 2)) (then (return (i32.const 2))))
    (local.set $p (i32.const 1))
    (block $done (loop $shift
      (br_if $done (i32.ge_u (local.get $p) (local.get $n)))
      (local.set $p (i32.shl (local.get $p) (i32.const 1)))
      (br_if $done (i32.le_s (local.get $p) (i32.const 0)))
      (br $shift)))
    (local.get $p))

  (func $put_str (param $src i32) (param $len i32) (param $at i32) (result i32)
    (memory.copy (local.get $at) (local.get $src) (local.get $len))
    (i32.add (local.get $at) (local.get $len)))

  (func $put_u (param $n i32) (param $at i32) (result i32)
    (local $len i32) (local $m i32) (local $i i32)
    (local.set $m (local.get $n))
    (local.set $len (i32.const 1))
    (block $done (loop $count
      (br_if $done (i32.lt_u (local.get $m) (i32.const 10)))
      (local.set $m (i32.div_u (local.get $m) (i32.const 10)))
      (local.set $len (i32.add (local.get $len) (i32.const 1)))
      (br $count)))
    (local.set $i (local.get $len))
    (local.set $m (local.get $n))
    (block $done2 (loop $write
      (br_if $done2 (i32.eqz (local.get $i)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (i32.store8 (i32.add (local.get $at) (local.get $i))
        (i32.add (i32.const 48) (i32.rem_u (local.get $m) (i32.const 10))))
      (local.set $m (i32.div_u (local.get $m) (i32.const 10)))
      (br $write)))
    (i32.add (local.get $at) (local.get $len)))

  (func $stopped (param $frac f32) (result i32)
    (if (call $progress (local.get $frac))
      (then (global.set $gstop (i32.const 1)) (return (i32.const 1))))
    (i32.const 0))

  (func $pbase (param $v i32) (result i32)
    (i32.add (global.get $gpos) (i32.mul (local.get $v) (i32.const 12))))
  (func $px (param $v i32) (result f32) (f32.load (call $pbase (local.get $v))))
  (func $py (param $v i32) (result f32) (f32.load offset=4 (call $pbase (local.get $v))))
  (func $pz (param $v i32) (result f32) (f32.load offset=8 (call $pbase (local.get $v))))
  (func $corner (param $t i32) (param $k i32) (result i32)
    (i32.load (i32.add (global.get $gtri)
      (i32.add (i32.mul (local.get $t) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4))))))
  (func $set_corner (param $t i32) (param $k i32) (param $v i32)
    (i32.store (i32.add (global.get $gtri)
      (i32.add (i32.mul (local.get $t) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4))))
      (local.get $v)))
  (func $tri_has (param $t i32) (param $v i32) (result i32)
    (i32.or (i32.or
      (i32.eq (call $corner (local.get $t) (i32.const 0)) (local.get $v))
      (i32.eq (call $corner (local.get $t) (i32.const 1)) (local.get $v)))
      (i32.eq (call $corner (local.get $t) (i32.const 2)) (local.get $v))))
  (func $alive (param $t i32) (result i32)
    (i32.load8_u (i32.add (global.get $galive) (local.get $t))))
  (func $locked (param $v i32) (result i32)
    (i32.load8_u (i32.add (global.get $glock) (local.get $v))))
  (func $lock (param $v i32)
    (i32.store8 (i32.add (global.get $glock) (local.get $v)) (i32.const 1)))
  (func $stamp (param $v i32) (result i32)
    (i32.load (i32.add (global.get $gstamp) (i32.mul (local.get $v) (i32.const 4)))))
  (func $bump (param $v i32)
    (i32.store (i32.add (global.get $gstamp) (i32.mul (local.get $v) (i32.const 4)))
      (i32.add (call $stamp (local.get $v)) (i32.const 1))))
  (func $mask (param $v i32) (result f32)
    (f32.load (i32.add (global.get $gmask) (i32.mul (local.get $v) (i32.const 4)))))
  (func $group (param $t i32) (result i32)
    (i32.load (i32.add (global.get $ggrp) (i32.mul (local.get $t) (i32.const 4)))))

  (func $qaddr (param $v i32) (result i32)
    (i32.add (global.get $gquad) (i32.mul (local.get $v) (i32.const 40))))

  (func $qadd_plane (param $v i32) (param $nx f32) (param $ny f32) (param $nz f32) (param $d f32) (param $w f32)
    (local $p i32) (local $a f32) (local $b f32) (local $c f32)
    (local.set $p (call $qaddr (local.get $v)))
    (local.set $a (f32.mul (local.get $nx) (local.get $w)))
    (local.set $b (f32.mul (local.get $ny) (local.get $w)))
    (local.set $c (f32.mul (local.get $nz) (local.get $w)))
    (f32.store (local.get $p) (f32.add (f32.load (local.get $p)) (f32.mul (local.get $nx) (local.get $a))))
    (f32.store offset=4 (local.get $p) (f32.add (f32.load offset=4 (local.get $p)) (f32.mul (local.get $ny) (local.get $a))))
    (f32.store offset=8 (local.get $p) (f32.add (f32.load offset=8 (local.get $p)) (f32.mul (local.get $nz) (local.get $a))))
    (f32.store offset=12 (local.get $p) (f32.add (f32.load offset=12 (local.get $p)) (f32.mul (local.get $d) (local.get $a))))
    (f32.store offset=16 (local.get $p) (f32.add (f32.load offset=16 (local.get $p)) (f32.mul (local.get $ny) (local.get $b))))
    (f32.store offset=20 (local.get $p) (f32.add (f32.load offset=20 (local.get $p)) (f32.mul (local.get $nz) (local.get $b))))
    (f32.store offset=24 (local.get $p) (f32.add (f32.load offset=24 (local.get $p)) (f32.mul (local.get $d) (local.get $b))))
    (f32.store offset=28 (local.get $p) (f32.add (f32.load offset=28 (local.get $p)) (f32.mul (local.get $nz) (local.get $c))))
    (f32.store offset=32 (local.get $p) (f32.add (f32.load offset=32 (local.get $p)) (f32.mul (local.get $d) (local.get $c))))
    (f32.store offset=36 (local.get $p) (f32.add (f32.load offset=36 (local.get $p)) (f32.mul (local.get $d) (f32.mul (local.get $d) (local.get $w))))))

  (func $qsum (param $a i32) (param $b i32)
    (local $i i32) (local $pa i32) (local $pb i32)
    (local.set $pa (call $qaddr (local.get $a)))
    (local.set $pb (call $qaddr (local.get $b)))
    (local.set $i (i32.const 0))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $i) (i32.const 10)))
      (f32.store (i32.add (i32.const 2048) (i32.mul (local.get $i) (i32.const 4)))
        (f32.add (f32.load (i32.add (local.get $pa) (i32.mul (local.get $i) (i32.const 4))))
                 (f32.load (i32.add (local.get $pb) (i32.mul (local.get $i) (i32.const 4))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))

  (func $qadd_into (param $dst i32) (param $src i32)
    (local $i i32) (local $pd i32) (local $ps i32)
    (local.set $pd (call $qaddr (local.get $dst)))
    (local.set $ps (call $qaddr (local.get $src)))
    (local.set $i (i32.const 0))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $i) (i32.const 10)))
      (f32.store (i32.add (local.get $pd) (i32.mul (local.get $i) (i32.const 4)))
        (f32.add (f32.load (i32.add (local.get $pd) (i32.mul (local.get $i) (i32.const 4))))
                 (f32.load (i32.add (local.get $ps) (i32.mul (local.get $i) (i32.const 4))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))

  (func $qerr (param $x f32) (param $y f32) (param $z f32) (result f32)
    (local $q0 f32) (local $q1 f32) (local $q2 f32) (local $q3 f32) (local $q4 f32)
    (local $q5 f32) (local $q6 f32) (local $q7 f32) (local $q8 f32) (local $q9 f32)
    (local.set $q0 (f32.load (i32.const 2048)))
    (local.set $q1 (f32.load offset=4 (i32.const 2048)))
    (local.set $q2 (f32.load offset=8 (i32.const 2048)))
    (local.set $q3 (f32.load offset=12 (i32.const 2048)))
    (local.set $q4 (f32.load offset=16 (i32.const 2048)))
    (local.set $q5 (f32.load offset=20 (i32.const 2048)))
    (local.set $q6 (f32.load offset=24 (i32.const 2048)))
    (local.set $q7 (f32.load offset=28 (i32.const 2048)))
    (local.set $q8 (f32.load offset=32 (i32.const 2048)))
    (local.set $q9 (f32.load offset=36 (i32.const 2048)))
    (f32.add
      (f32.add
        (f32.add (f32.mul (local.get $q0) (f32.mul (local.get $x) (local.get $x)))
                 (f32.mul (f32.const 2) (f32.mul (local.get $q1) (f32.mul (local.get $x) (local.get $y)))))
        (f32.add (f32.mul (f32.const 2) (f32.mul (local.get $q2) (f32.mul (local.get $x) (local.get $z))))
                 (f32.mul (f32.const 2) (f32.mul (local.get $q3) (local.get $x)))))
      (f32.add
        (f32.add (f32.mul (local.get $q4) (f32.mul (local.get $y) (local.get $y)))
                 (f32.mul (f32.const 2) (f32.mul (local.get $q5) (f32.mul (local.get $y) (local.get $z)))))
        (f32.add
          (f32.add (f32.mul (f32.const 2) (f32.mul (local.get $q6) (local.get $y)))
                   (f32.mul (local.get $q7) (f32.mul (local.get $z) (local.get $z))))
          (f32.add (f32.mul (f32.const 2) (f32.mul (local.get $q8) (local.get $z))) (local.get $q9))))))

  (func $finite (param $x f32) (result i32)
    (i32.and (f32.eq (local.get $x) (local.get $x)) (f32.lt (f32.abs (local.get $x)) (f32.const 1e19))))

  (func $consider_pt (param $x f32) (param $y f32) (param $z f32)
    (local $e f32)
    (if (i32.eqz (i32.and (i32.and (call $finite (local.get $x)) (call $finite (local.get $y))) (call $finite (local.get $z))))
      (then (return)))
    (local.set $e (call $qerr (local.get $x) (local.get $y) (local.get $z)))
    (if (i32.eqz (call $finite (local.get $e))) (then (return)))
    (if (f32.lt (local.get $e) (f32.const 0)) (then (local.set $e (f32.const 0))))
    (if (i32.or (i32.eqz (global.get $ghave)) (f32.lt (local.get $e) (global.get $gcost)))
      (then
        (global.set $ghave (i32.const 1))
        (global.set $gcost (local.get $e))
        (global.set $gtx (local.get $x))
        (global.set $gty (local.get $y))
        (global.set $gtz (local.get $z)))))

  ;; Cheapest of the legal placements. A locked endpoint is the only choice.
  (func $best (param $a i32) (param $b i32) (result i32)
    (local $la i32) (local $lb i32)
    (local.set $la (call $locked (local.get $a)))
    (local.set $lb (call $locked (local.get $b)))
    (if (i32.and (local.get $la) (local.get $lb)) (then (return (i32.const 0))))
    (call $qsum (local.get $a) (local.get $b))
    (global.set $ghave (i32.const 0))
    (global.set $gcost (f32.const inf))
    (if (local.get $la)
      (then (call $consider_pt (call $px (local.get $a)) (call $py (local.get $a)) (call $pz (local.get $a))))
      (else
        (if (local.get $lb)
          (then (call $consider_pt (call $px (local.get $b)) (call $py (local.get $b)) (call $pz (local.get $b))))
          (else
            (call $consider_pt (call $px (local.get $a)) (call $py (local.get $a)) (call $pz (local.get $a)))
            (call $consider_pt (call $px (local.get $b)) (call $py (local.get $b)) (call $pz (local.get $b)))
            (call $consider_pt
              (f32.mul (f32.add (call $px (local.get $a)) (call $px (local.get $b))) (f32.const 0.5))
              (f32.mul (f32.add (call $py (local.get $a)) (call $py (local.get $b))) (f32.const 0.5))
              (f32.mul (f32.add (call $pz (local.get $a)) (call $pz (local.get $b))) (f32.const 0.5)))))))
    (global.get $ghave))

  (func $pool_tri (param $node i32) (result i32)
    (i32.load (i32.add (global.get $gpool) (i32.mul (local.get $node) (i32.const 8)))))
  (func $pool_next (param $node i32) (result i32)
    (i32.load offset=4 (i32.add (global.get $gpool) (i32.mul (local.get $node) (i32.const 8)))))
  (func $set_pool_next (param $node i32) (param $next i32)
    (i32.store offset=4 (i32.add (global.get $gpool) (i32.mul (local.get $node) (i32.const 8))) (local.get $next)))
  (func $head (param $v i32) (result i32)
    (i32.load (i32.add (global.get $ghead) (i32.mul (local.get $v) (i32.const 4)))))
  (func $set_head (param $v i32) (param $node i32)
    (i32.store (i32.add (global.get $ghead) (i32.mul (local.get $v) (i32.const 4))) (local.get $node)))

  (func $unlink (param $v i32) (param $t i32) (result i32)
    (local $prev i32) (local $cur i32) (local $next i32)
    (local.set $prev (i32.const -1))
    (local.set $cur (call $head (local.get $v)))
    (block $done (loop $walk
      (br_if $done (i32.eq (local.get $cur) (i32.const -1)))
      (local.set $next (call $pool_next (local.get $cur)))
      (if (i32.eq (call $pool_tri (local.get $cur)) (local.get $t))
        (then
          (if (i32.eq (local.get $prev) (i32.const -1))
            (then (call $set_head (local.get $v) (local.get $next)))
            (else (call $set_pool_next (local.get $prev) (local.get $next))))
          (return (local.get $cur))))
      (local.set $prev (local.get $cur))
      (local.set $cur (local.get $next))
      (br $walk)))
    (i32.const -1))

  (func $push_node (param $v i32) (param $node i32)
    (call $set_pool_next (local.get $node) (call $head (local.get $v)))
    (call $set_head (local.get $v) (local.get $node)))

  (func $kill (param $t i32)
    (if (i32.eqz (call $alive (local.get $t))) (then (return)))
    (i32.store8 (i32.add (global.get $galive) (local.get $t)) (i32.const 0))
    (global.set $galive_n (i32.sub (global.get $galive_n) (i32.const 1)))
    (drop (call $unlink (call $corner (local.get $t) (i32.const 0)) (local.get $t)))
    (drop (call $unlink (call $corner (local.get $t) (i32.const 1)) (local.get $t)))
    (drop (call $unlink (call $corner (local.get $t) (i32.const 2)) (local.get $t))))

  (func $rewire (param $t i32) (param $a i32) (param $b i32)
    (local $node i32) (local $k i32)
    (local.set $node (call $unlink (local.get $b) (local.get $t)))
    (local.set $k (i32.const 0))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $k) (i32.const 3)))
      (if (i32.eq (call $corner (local.get $t) (local.get $k)) (local.get $b))
        (then (call $set_corner (local.get $t) (local.get $k) (local.get $a))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $l)))
    (if (i32.ge_s (local.get $node) (i32.const 0))
      (then (call $push_node (local.get $a) (local.get $node)))))

  ;; Unique alive triangle ids of v, at `dst`. 255 means the cap was hit.
  (func $collect (param $v i32) (param $dst i32) (result i32)
    (local $n i32) (local $node i32) (local $t i32) (local $i i32) (local $found i32)
    (local.set $n (i32.const 0))
    (local.set $node (call $head (local.get $v)))
    (block $done (loop $walk
      (br_if $done (i32.eq (local.get $node) (i32.const -1)))
      (local.set $t (call $pool_tri (local.get $node)))
      (if (call $alive (local.get $t))
        (then
          (local.set $found (i32.const 0))
          (local.set $i (i32.const 0))
          (block $u (loop $uniq
            (br_if $u (i32.ge_u (local.get $i) (local.get $n)))
            (if (i32.eq (i32.load (i32.add (local.get $dst) (i32.mul (local.get $i) (i32.const 4)))) (local.get $t))
              (then (local.set $found (i32.const 1)) (br $u)))
