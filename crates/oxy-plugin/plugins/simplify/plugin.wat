    (if (i32.or (i32.le_s (local.get $n) (i32.const 0)) (i32.le_s (local.get $nt) (i32.const 0)))
      (then (return)))
    (local.set $amount (i32.trunc_sat_f32_s (call $param (i32.const 0))))
    (if (i32.lt_s (local.get $amount) (i32.const 0)) (then (local.set $amount (i32.const 0))))
    (if (i32.gt_s (local.get $amount) (i32.const 90)) (then (local.set $amount (i32.const 90))))
    (local.set $keep (i32.div_u (i32.mul (local.get $nt) (i32.sub (i32.const 100) (local.get $amount))) (i32.const 100)))
    (if (i32.lt_u (local.get $keep) (i32.const 4)) (then (local.set $keep (i32.const 4))))
    (if (i32.or (i32.le_u (local.get $nt) (i32.const 4)) (i32.ge_u (local.get $keep) (local.get $nt)))
      (then (call $log (i32.const 0) (i32.const 17)) (return)))
    (if (i32.or (i32.gt_u (local.get $n) (i32.const 80000)) (i32.gt_u (local.get $nt) (i32.const 80000)))
      (then (call $log (i32.const 128) (i32.const 35)) (return)))
    (global.set $gn (local.get $n))
    (global.set $gnt (local.get $nt))
    (global.set $gtarget (local.get $keep))
    (global.set $galive_n (local.get $nt))
    (global.set $gstop (i32.const 0))
    (global.set $gdid (i32.const 0))
    (global.set $ghn (i32.const 0))
    (global.set $gpayn (i32.const 0))
    (local.set $bound (f32.ge (call $param (i32.const 1)) (f32.const 0.5)))
    (local.set $groups (f32.ge (call $param (i32.const 2)) (f32.const 0.5)))
    (local.set $pmask (f32.ge (call $param (i32.const 3)) (f32.const 0.5)))
