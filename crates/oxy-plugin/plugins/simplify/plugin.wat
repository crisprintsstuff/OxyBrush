    (block $d (loop $w
      (br_if $d (i32.eq (local.get $node) (i32.const -1)))
      (local.set $t (call $pool_tri (local.get $node)))
      (if (i32.and (call $alive (local.get $t))
            (i32.and (call $tri_has (local.get $t) (local.get $b)) (call $border_tri (local.get $t))))
