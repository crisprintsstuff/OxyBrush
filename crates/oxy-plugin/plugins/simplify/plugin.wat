        (f32.store offset=4 (local.get $off) (call $py (local.get $v)))
        (f32.store offset=8 (local.get $off) (call $pz (local.get $v))))))

  (func $cross_at (param $dst i32)
    (local $ax f32) (local $ay f32) (local $az f32)
    (local $bx f32) (local $by f32) (local $bz f32)
    (local.set $ax (f32.sub (f32.load (i32.const 2220)) (f32.load (i32.const 2208))))
    (local.set $ay (f32.sub (f32.load offset=4 (i32.const 2220)) (f32.load offset=4 (i32.const 2208))))
    (local.set $az (f32.sub (f32.load offset=8 (i32.const 2220)) (f32.load offset=8 (i32.const 2208))))
    (local.set $bx (f32.sub (f32.load (i32.const 2232)) (f32.load (i32.const 2208))))
    (local.set $by (f32.sub (f32.load offset=4 (i32.const 2232)) (f32.load offset=4 (i32.const 2208))))
    (local.set $bz (f32.sub (f32.load offset=8 (i32.const 2232)) (f32.load offset=8 (i32.const 2208))))
    (f32.store (local.get $dst) (f32.sub (f32.mul (local.get $ay) (local.get $bz)) (f32.mul (local.get $az) (local.get $by))))
    (f32.store offset=4 (local.get $dst) (f32.sub (f32.mul (local.get $az) (local.get $bx)) (f32.mul (local.get $ax) (local.get $bz))))
    (f32.store offset=8 (local.get $dst) (f32.sub (f32.mul (local.get $ax) (local.get $by)) (f32.mul (local.get $ay) (local.get $bx)))))

  (func $len2_at (param $p i32) (result f32)
    (f32.add (f32.mul (f32.load (local.get $p)) (f32.load (local.get $p)))
      (f32.add (f32.mul (f32.load offset=4 (local.get $p)) (f32.load offset=4 (local.get $p)))
               (f32.mul (f32.load offset=8 (local.get $p)) (f32.load offset=8 (local.get $p))))))

  ;; 1 when moving `v` to the target would flip or flatten a surviving triangle.
  (func $flips (param $v i32) (param $other i32) (result i32)
    (local $node i32) (local $t i32) (local $k i32)
    (local $before f32) (local $after f32) (local $dot f32)
    (local.set $node (call $head (local.get $v)))
    (block $d (loop $w
      (br_if $d (i32.eq (local.get $node) (i32.const -1)))
      (local.set $t (call $pool_tri (local.get $node)))
      (if (i32.and (call $alive (local.get $t)) (i32.eqz (call $tri_has (local.get $t) (local.get $other))))
        (then
          (local.set $k (i32.const 0))
          (block $kd (loop $kk
            (br_if $kd (i32.ge_u (local.get $k) (i32.const 3)))
            (call $store_pt (i32.add (i32.const 2208) (i32.mul (local.get $k) (i32.const 12)))
              (call $corner (local.get $t) (local.get $k)) (i32.const -1))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $kk)))
          (call $cross_at (i32.const 2256))
          (local.set $before (call $len2_at (i32.const 2256)))
          (local.set $k (i32.const 0))
          (block $kd2 (loop $kk2
            (br_if $kd2 (i32.ge_u (local.get $k) (i32.const 3)))
            (call $store_pt (i32.add (i32.const 2208) (i32.mul (local.get $k) (i32.const 12)))
              (call $corner (local.get $t) (local.get $k)) (local.get $v))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $kk2)))
          (call $cross_at (i32.const 2272))
          (local.set $after (call $len2_at (i32.const 2272)))
          (local.set $dot (f32.add
            (f32.mul (f32.load (i32.const 2256)) (f32.load (i32.const 2272)))
            (f32.add (f32.mul (f32.load offset=4 (i32.const 2256)) (f32.load offset=4 (i32.const 2272)))
                     (f32.mul (f32.load offset=8 (i32.const 2256)) (f32.load offset=8 (i32.const 2272))))))
          (if (i32.or (i32.eqz (call $finite (local.get $dot))) (f32.le (local.get $dot) (f32.const 0)))
            (then (return (i32.const 1))))
