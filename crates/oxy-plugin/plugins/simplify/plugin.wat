        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $link)))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $bt)))
    (if (i32.or (local.get $bound) (local.get $groups))
      (then
        (local.set $t (i32.const 0))
        (block $lk (loop $locks
          (br_if $lk (i32.ge_u (local.get $t) (local.get $nt)))
          (local.set $k (i32.const 0))
          (block $ek (loop $ee
            (br_if $ek (i32.ge_u (local.get $k) (i32.const 3)))
            (local.set $a (call $corner (local.get $t) (local.get $k)))
            (local.set $b (call $corner (local.get $t) (i32.rem_u (i32.add (local.get $k) (i32.const 1)) (i32.const 3))))
            ;; Look up every edge, not only the a < b direction. A boundary
            ;; edge lives in one triangle, so the other direction never appears.
            (local.set $slot (call $lookup (local.get $a) (local.get $b)))
            (if (i32.ge_s (local.get $slot) (i32.const 0))
              (then
                (if (i32.or
                      (i32.and (local.get $bound) (i32.ne (i32.load offset=8 (local.get $slot)) (i32.const 2)))
                      (i32.and (local.get $groups) (i32.eq (i32.load offset=12 (local.get $slot)) (i32.const -1))))
                  (then (call $lock (local.get $a)) (call $lock (local.get $b))))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $ee)))
          (local.set $t (i32.add (local.get $t) (i32.const 1)))
          (br $locks)))))
    (if (local.get $pmask)
      (then
        (local.set $i (i32.const 0))
        (block $mk (loop $mm
          (br_if $mk (i32.ge_u (local.get $i) (local.get $n)))
          (if (f32.ge (call $mask (local.get $i)) (f32.const 0.999)) (then (call $lock (local.get $i))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $mm)))))
    (if (call $stopped (f32.const 0.15)) (then (return)))
    (local.set $t (i32.const 0))
    (block $sd (loop $seed
      (br_if $sd (i32.ge_u (local.get $t) (local.get $nt)))
      (local.set $k (i32.const 0))
      (block $sk (loop $se
        (br_if $sk (i32.ge_u (local.get $k) (i32.const 3)))
        (local.set $a (call $corner (local.get $t) (local.get $k)))
        (local.set $b (call $corner (local.get $t) (i32.rem_u (i32.add (local.get $k) (i32.const 1)) (i32.const 3))))
        (if (i32.lt_u (local.get $a) (local.get $b)) (then (call $queue_edge (local.get $a) (local.get $b))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $se)))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $seed)))
    (if (global.get $gstop) (then (return)))
    (local.set $pops (i32.const 0))
    (local.set $partial (i32.const 0))
    (block $out (loop $pop
      (if (i32.le_u (global.get $galive_n) (global.get $gtarget)) (then (br $out)))
      (if (i32.gt_u (local.get $pops) (i32.const 200000))
        (then (local.set $partial (i32.const 1)) (br $out)))
      (local.set $pops (i32.add (local.get $pops) (i32.const 1)))
      (if (i32.eqz (i32.and (local.get $pops) (i32.const 255)))
        (then
          (local.set $removed (i32.sub (local.get $nt) (global.get $galive_n)))
          (local.set $need (i32.sub (local.get $nt) (global.get $gtarget)))
          (if (i32.eqz (local.get $need)) (then (local.set $need (i32.const 1))))
          (if (call $stopped (f32.add (f32.const 0.2)
                (f32.mul (f32.const 0.7) (f32.div (f32.convert_i32_u (local.get $removed)) (f32.convert_i32_u (local.get $need))))))
            (then (return)))))
      (local.set $idx (call $pop))
      (if (i32.lt_s (local.get $idx) (i32.const 0))
        (then (local.set $partial (i32.const 1)) (br $out)))
      (drop (call $try (call $pay (local.get $idx) (i32.const 0)) (call $pay (local.get $idx) (i32.const 1))
        (call $pay (local.get $idx) (i32.const 2)) (call $pay (local.get $idx) (i32.const 3))))
      (br $pop)))
    (if (global.get $gstop) (then (return)))
    (if (i32.eqz (global.get $gdid))
      (then
        (drop (call $progress (f32.const 1)))
        (call $log (i32.const 0) (i32.const 17))
        (return)))
    ;; Compact to the triangles that are still alive and not degenerate.
    (local.set $i (i32.const 0))
    (block $rm (loop $rr
      (br_if $rm (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store (i32.add (global.get $gstamp) (i32.mul (local.get $i) (i32.const 4))) (i32.const -1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $rr)))
    (global.set $gnewn (i32.const 0))
    (global.set $gnewnt (i32.const 0))
    (local.set $t (i32.const 0))
    (block $ct (loop $keep
      (br_if $ct (i32.ge_u (local.get $t) (local.get $nt)))
      (if (i32.and (call $alive (local.get $t)) (i32.eqz (call $bad_tri (local.get $t))))
        (then
          (local.set $k (i32.const 0))
          (block $ck (loop $cv
            (br_if $ck (i32.ge_u (local.get $k) (i32.const 3)))
            (local.set $a (call $corner (local.get $t) (local.get $k)))
            (if (i32.eq (i32.load (i32.add (global.get $gstamp) (i32.mul (local.get $a) (i32.const 4)))) (i32.const -1))
              (then
                (i32.store (i32.add (global.get $gstamp) (i32.mul (local.get $a) (i32.const 4))) (global.get $gnewn))
                (call $copy_vert (local.get $a) (global.get $gnewn))
                (global.set $gnewn (i32.add (global.get $gnewn) (i32.const 1)))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $cv)))
          (local.set $ra (i32.load (i32.add (global.get $gstamp) (i32.mul (call $corner (local.get $t) (i32.const 0)) (i32.const 4)))))
          (local.set $rb (i32.load (i32.add (global.get $gstamp) (i32.mul (call $corner (local.get $t) (i32.const 1)) (i32.const 4)))))
          (local.set $rci (i32.load (i32.add (global.get $gstamp) (i32.mul (call $corner (local.get $t) (i32.const 2)) (i32.const 4)))))
          (local.set $at (i32.add (global.get $goutt) (i32.mul (global.get $gnewnt) (i32.const 12))))
          (i32.store (local.get $at) (local.get $ra))
          (i32.store offset=4 (local.get $at) (local.get $rb))
          (i32.store offset=8 (local.get $at) (local.get $rci))
          (i32.store (i32.add (global.get $goutg) (i32.mul (global.get $gnewnt) (i32.const 4))) (call $group (local.get $t)))
          (i32.store8 (i32.add (global.get $gouth) (global.get $gnewnt))
            (i32.load8_u (i32.add (global.get $ghid) (local.get $t))))
          (global.set $gnewnt (i32.add (global.get $gnewnt) (i32.const 1)))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $keep)))
    (if (i32.or (i32.lt_u (global.get $gnewn) (i32.const 3)) (i32.lt_u (global.get $gnewnt) (i32.const 1)))
      (then (call $log (i32.const 288) (i32.const 28)) (return)))
    (local.set $rc (call $write_mesh (global.get $gpiece) (global.get $goutp) (global.get $gnewn)
      (global.get $goutt) (global.get $gnewnt)))
    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (call $log (i32.const 256) (i32.const 24)) (return)))
    (local.set $rc (call $write_mask (global.get $gpiece) (global.get $goutm) (global.get $gnewn)))
    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (call $log (i32.const 256) (i32.const 24)) (return)))
    (local.set $rc (call $write_colors (global.get $gpiece) (global.get $goutc) (global.get $gnewn)))
    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (call $log (i32.const 256) (i32.const 24)) (return)))
    (local.set $rc (call $write_groups (global.get $gpiece) (global.get $goutg) (global.get $gnewnt)))
    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (call $log (i32.const 256) (i32.const 24)) (return)))
    (local.set $rc (call $write_hidden (global.get $gpiece) (global.get $gouth) (global.get $gnewnt)))
    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (call $log (i32.const 256) (i32.const 24)) (return)))
    (drop (call $progress (f32.const 1)))
    (local.set $at (call $put_str (i32.const 32) (i32.const 8) (i32.const 512)))
    (local.set $removed (i32.sub (local.get $nt) (global.get $gnewnt)))
    (if (i32.lt_s (local.get $removed) (i32.const 0)) (then (local.set $removed (i32.const 0))))
    (local.set $at (call $put_u (local.get $removed) (local.get $at)))
    (local.set $at (call $put_str (i32.const 48) (i32.const 10) (local.get $at)))
    (if (i32.or (local.get $partial) (i32.gt_u (global.get $gnewnt) (global.get $gtarget)))
      (then (local.set $at (call $put_str (i32.const 64) (i32.const 29) (local.get $at)))))
    (call $log (i32.const 512) (i32.sub (local.get $at) (i32.const 512)))))
