      (br $walk)))
    (local.get $n))

  (func $ring (param $v i32) (param $dst i32) (result i32)
    (local $n i32) (local $node i32) (local $t i32) (local $k i32) (local $u i32)
    (local $i i32) (local $found i32)
    (local.set $n (i32.const 0))
    (local.set $node (call $head (local.get $v)))
    (block $done (loop $walk
      (br_if $done (i32.eq (local.get $node) (i32.const -1)))
