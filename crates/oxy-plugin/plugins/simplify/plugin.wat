          (local.set $ny (f32.div (local.get $ny) (local.get $area)))
          (local.set $nz (f32.div (local.get $nz) (local.get $area)))
          (local.set $d (f32.neg (f32.add (f32.mul (local.get $nx) (call $px (local.get $a)))
            (f32.add (f32.mul (local.get $ny) (call $py (local.get $a))) (f32.mul (local.get $nz) (call $pz (local.get $a)))))))
          (call $qadd_plane (local.get $a) (local.get $nx) (local.get $ny) (local.get $nz) (local.get $d) (local.get $area))
          (call $qadd_plane (local.get $b) (local.get $nx) (local.get $ny) (local.get $nz) (local.get $d) (local.get $area))
          (call $qadd_plane (local.get $c) (local.get $nx) (local.get $ny) (local.get $nz) (local.get $d) (local.get $area))))
