              (br $l)))))))
    (f32.store (i32.add (global.get $gmask) (i32.mul (local.get $a) (i32.const 4)))
      (f32.max (call $mask (local.get $a)) (call $mask (local.get $b))))
    (f32.store (call $pbase (local.get $a)) (global.get $gtx))
    (f32.store offset=4 (call $pbase (local.get $a)) (global.get $gty))
    (f32.store offset=8 (call $pbase (local.get $a)) (global.get $gtz))
    (call $qadd_into (local.get $a) (local.get $b))
    (if (call $locked (local.get $b)) (then (call $lock (local.get $a)))))

  (func $ordered (param $c f32) (result i32)
    (if (i32.eqz (call $finite (local.get $c))) (then (local.set $c (f32.const 1e20))))
    (if (f32.lt (local.get $c) (f32.const 0)) (then (local.set $c (f32.const 0))))
    (i32.or (i32.reinterpret_f32 (local.get $c)) (i32.shl (i32.const 1) (i32.const 31))))

  (func $hkey (param $i i32) (result i32)
    (i32.load (i32.add (global.get $ghkey) (i32.mul (local.get $i) (i32.const 4)))))
  (func $hslot (param $i i32) (result i32)
    (i32.load (i32.add (global.get $ghslot) (i32.mul (local.get $i) (i32.const 4)))))
  (func $hset (param $i i32) (param $key i32) (param $slot i32)
    (i32.store (i32.add (global.get $ghkey) (i32.mul (local.get $i) (i32.const 4))) (local.get $key))
    (i32.store (i32.add (global.get $ghslot) (i32.mul (local.get $i) (i32.const 4))) (local.get $slot)))

  (func $siftdown (param $i i32)
    (local $n i32) (local $key i32) (local $slot i32)
    (local $left i32) (local $right i32) (local $best i32) (local $bk i32)
    (local.set $n (global.get $ghn))
    (local.set $key (call $hkey (local.get $i)))
    (local.set $slot (call $hslot (local.get $i)))
    (block $done (loop $s
      (local.set $left (i32.add (i32.shl (local.get $i) (i32.const 1)) (i32.const 1)))
      (br_if $done (i32.ge_u (local.get $left) (local.get $n)))
      (local.set $best (local.get $left))
      (local.set $bk (call $hkey (local.get $left)))
      (local.set $right (i32.add (local.get $left) (i32.const 1)))
      (if (i32.lt_u (local.get $right) (local.get $n))
        (then
          (if (i32.lt_u (call $hkey (local.get $right)) (local.get $bk))
            (then
              (local.set $best (local.get $right))
              (local.set $bk (call $hkey (local.get $right)))))))
      (br_if $done (i32.ge_u (local.get $bk) (local.get $key)))
      (call $hset (local.get $i) (local.get $bk) (call $hslot (local.get $best)))
      (local.set $i (local.get $best))
      (br $s)))
    (call $hset (local.get $i) (local.get $key) (local.get $slot)))

  (func $push (param $cost f32) (param $a i32) (param $b i32) (param $sa i32) (param $sb i32)
    (local $i i32) (local $parent i32) (local $key i32) (local $pk i32) (local $idx i32)
    (if (i32.ge_u (global.get $gpayn) (global.get $gpaycap)) (then (return)))
    (if (i32.ge_u (global.get $ghn) (global.get $ghcap)) (then (return)))
    (local.set $idx (global.get $gpayn))
    (global.set $gpayn (i32.add (local.get $idx) (i32.const 1)))
    (local.set $i (i32.add (global.get $gpay) (i32.mul (local.get $idx) (i32.const 16))))
    (i32.store (local.get $i) (local.get $a))
    (i32.store offset=4 (local.get $i) (local.get $b))
    (i32.store offset=8 (local.get $i) (local.get $sa))
    (i32.store offset=12 (local.get $i) (local.get $sb))
    (local.set $key (call $ordered (local.get $cost)))
    (local.set $i (global.get $ghn))
    (global.set $ghn (i32.add (local.get $i) (i32.const 1)))
