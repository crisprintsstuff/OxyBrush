    (global.set $gmask (call $align4 (i32.add (global.get $gtri) (i32.mul (local.get $nt) (i32.const 12)))))
    (global.set $gcol (call $align4 (i32.add (global.get $gmask) (i32.mul (local.get $n) (i32.const 4)))))
    (global.set $ggrp (call $align4 (i32.add (global.get $gcol) (i32.mul (local.get $n) (i32.const 12)))))
