          (block $kd (loop $kk
            (br_if $kd (i32.ge_u (local.get $k) (i32.const 3)))
            (local.set $u (call $corner (local.get $t) (local.get $k)))
            (if (i32.ne (local.get $u) (local.get $v))
              (then
                (local.set $found (i32.const 0))
                (local.set $i (i32.const 0))
                (block $ud (loop $uu
                  (br_if $ud (i32.ge_u (local.get $i) (local.get $n)))
                  (if (i32.eq (i32.load (i32.add (local.get $dst) (i32.mul (local.get $i) (i32.const 4)))) (local.get $u))
                    (then (local.set $found (i32.const 1)) (br $ud)))
