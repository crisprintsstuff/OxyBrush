  (func $dist2 (param $v i32) (result f32)
    (local $dx f32) (local $dy f32) (local $dz f32)
    (local.set $dx (f32.sub (global.get $gtx) (call $px (local.get $v))))
    (local.set $dy (f32.sub (global.get $gty) (call $py (local.get $v))))
    (local.set $dz (f32.sub (global.get $gtz) (call $pz (local.get $v))))
