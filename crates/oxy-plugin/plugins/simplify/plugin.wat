                    (i32.store (i32.add (local.get $dst) (i32.mul (local.get $n) (i32.const 4))) (local.get $u))
                    (local.set $n (i32.add (local.get $n) (i32.const 1)))))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $kk)))))
      (local.set $node (call $pool_next (local.get $node)))
      (br $walk)))
    (local.get $n))

  (func $has_edge (param $a i32) (param $b i32) (result i32)
    (local $node i32) (local $t i32)
    (local.set $node (call $head (local.get $a)))
    (block $d (loop $w
      (br_if $d (i32.eq (local.get $node) (i32.const -1)))
      (local.set $t (call $pool_tri (local.get $node)))
      (if (i32.and (call $alive (local.get $t)) (call $tri_has (local.get $t) (local.get $b)))
        (then (return (i32.const 1))))
